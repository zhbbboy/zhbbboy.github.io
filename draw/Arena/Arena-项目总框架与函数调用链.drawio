        <mxCell id="edge2" value="LookAction Triggered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;exitX=0.68;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="look">
