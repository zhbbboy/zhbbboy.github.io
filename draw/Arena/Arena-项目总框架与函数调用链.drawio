        <mxCell id="build" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;构建与模块声明&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;.uproject：UE 5.4 / Runtime 模块 BoomerShooter&lt;br&gt;Target：Game / Editor；Build.cs：EnhancedInput、Niagara 等&lt;br&gt;IMPLEMENT_PRIMARY_GAME_MODULE：注册模块，并非 gameplay 的 main()&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;BoomerShooter.cpp / .Build.cs / 两份 Target.cs&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf0f5;strokeColor=#8492a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="195" />
        </mxCell>
        <mxCell id="config" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;地图与 GameMode 配置&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;DefaultEngine.ini：GameDefaultMap = Menu&lt;br&gt;GlobalDefaultGameMode = /Game/BP_GameMode.BP_GameMode_C&lt;br&gt;Menu 的按钮、关卡覆盖和 BP 父类需编辑器确认。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Config/DefaultEngine.ini:62、69、71&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="410" width="480" height="165" />
        </mxCell>
        <mxCell id="mode" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterGameMode::&lt;br&gt;ABoomerShooterGameMode()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;FClassFinder&amp;lt;APawn&amp;gt; 查找 BP_FirstPersonCharacter；&lt;br&gt;将 DefaultPawnClass 设为找到的蓝图类。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;BoomerShooterGameMode.cpp:8&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf0f5;strokeColor=#8492a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="630" width="480" height="175" />
        </mxCell>
        <mxCell id="ueplayer" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UE 创建 / 初始化 / 控制玩家&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;构造函数创建相机和设置胶囊；&lt;br&gt;PostInitializeComponents 发生在组件初始化后；&lt;br&gt;BeginPlay 与输入注册由 UE 调度。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf0f5;strokeColor=#8492a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
