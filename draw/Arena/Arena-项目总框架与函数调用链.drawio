        <mxCell id="check2" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;武器参数&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BP_Sniper / BP_Shotgun / BP_MiniGun / BP_RocketBow；&lt;br&gt;核验 Projectile、ShootTime、BulletsPerShot、SpreadDistance；&lt;br&gt;BulletDamage、音效、Niagara 与命中特效。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
