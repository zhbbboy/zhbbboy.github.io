        <mxCell id="subtitle" value="Rocket 的有效命中处理位于 Tick；Bounce 的反射代码被注释；Standard 没有专用 Sweep/伤害分支。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
