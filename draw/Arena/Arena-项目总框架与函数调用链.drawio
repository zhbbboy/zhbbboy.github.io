          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="spawn" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;两个生成入口&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;AWeapon::Fire → SpawnActor&amp;lt;AProjectile&amp;gt; + BulletDamage；&lt;br&gt;UShootProjectile::TickComponent → SpawnActor + BulletDamage。&lt;br&gt;敌我行为不由生成入口自动决定：EnemyBullet 需蓝图配置。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="205" />
        </mxCell>
        <mxCell id="begin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AProjectile::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;缓存 World、PlayerActor、PlayerCharacter；&lt;br&gt;绑定 Hit/Overlap；记录 PreviousLocation；&lt;br&gt;PlayerCharacter-&amp;gt;GetSpawnManager()。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Projectile.cpp:41&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="450" width="480" height="205" />
        </mxCell>
        <mxCell id="empty" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;OnComponentHit / OnComponentOverlap&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;两个回调体均为空。&lt;br&gt;BeginPlay 的 AddDynamic 绑定确实存在，&lt;br&gt;但不能把它们画成实际伤害入口。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Projectile.cpp:56、61&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="725" width="480" height="190" />
        </mxCell>
        <mxCell id="tick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AProjectile::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;SetPhysicsLinearVelocity(Forward * Speed * DeltaTime)；&lt;br&gt;GetWaveCharacters() 取当前敌人（内部会清理）；&lt;br&gt;EnemyBullet：忽略敌人；否则：忽略玩家。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Projectile.cpp:66&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="205" />
        </mxCell>
        <mxCell id="sweep" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UWorld::SweepSingleByObjectType()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;从当前位置 RayOrigin 到 PreviousLocation；&lt;br&gt;Rocket：球半径 CollisionSize；Bounce：球半径 2；&lt;br&gt;对象类型 Pawn / WorldStatic。&lt;br&gt;Standard 没有此检测分支。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Projectile.cpp:66（Tick 内部）&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf0f5;strokeColor=#8492a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="450" width="480" height="225" />
        </mxCell>
        <mxCell id="hit" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;命中 Actor + ProjectileType == Rocket&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;可选生成 Explosion 与播放音效；&lt;br&gt;EnemyBullet=true → 仅命中玩家时 TookDamage；&lt;br&gt;EnemyBullet=false → 遍历当前波次，范围内 DamageEnemy；&lt;br&gt;最后 Destroy() 当前投射物。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="750" width="480" height="230" />
        </mxCell>
        <mxCell id="took" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;TookDamage()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;EnemyBullet 为真，且 ActorHit == PlayerCharacter：&lt;br&gt;扣血、清空 Combo、设置方向提示；死亡切图。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:335&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="450" width="480" height="190" />
        </mxCell>
        <mxCell id="damage" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyCharacter::&lt;br&gt;DamageEnemy()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;玩家 Rocket 遍历 EnemyActors；&lt;br&gt;距离 Hit.ImpactPoint &amp;lt;= DamageRadius 的敌人受伤。&lt;br&gt;目标死亡会进入 07 页闭环。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemyCharacter.cpp:68&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="750" width="480" height="205" />
        </mxCell>
        <mxCell id="edge1" value="SpawnActor 触发 UE 生命周期" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="spawn" target="begin">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="事件注册；回调无玩法逻辑" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="begin" target="empty">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="缓存引用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8c96a5;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=1 4;exitX=1;exitY=0.3;entryX=0;entryY=0.8;" edge="1" parent="1" source="begin" target="tick">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" value="Rocket / Bounce 分支" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="tick" target="sweep">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" value="Rocket 且命中有效 Actor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="sweep" target="hit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge6" value="敌方命中" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.2;entryX=0;entryY=0.8;" edge="1" parent="1" source="hit" target="took">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge7" value="范围伤害" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="hit" target="damage">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="learn" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;每帧结束与未完成分支&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Tick 最后更新 PreviousLocation，并让 Actor 位置/旋转跟随 Mesh。&lt;br&gt;Bounce 仅进行 Sweep，反射处理被注释；Standard 只走共同移动/同步逻辑。速度乘 DeltaTime 是当前实现，应先理解再评估。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1040" width="1640" height="130" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p08" name="07 敌人死亡、计分与波次">
    <mxGraphModel dx="1720" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="07 敌人死亡、计分与波次" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#253349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1640" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="死亡函数做即时清理；下一波由管理器之后的 Tick 检查，不是 DamageEnemy 直接调用 SpawnWave。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
        </mxCell>
        <mxCell id="legend" value="实线：直接调用/分支步骤　蓝虚线：UE 调度/输入/委托　灰点线：状态或引用　橙虚线：蓝图待确认" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="115" width="1640" height="32" />
        </mxCell>
        <mxCell id="footer" value="当前源码快照 2026-10-11 · 文件位置相对 BoomerShooter/Source/BoomerShooter/ · 未执行 PIE · 阅读顺序见 00 页" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="spbegin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemySpawnerManager::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;缓存 World → 直接调用 SpawnWave()。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemySpawnerManager.cpp:34&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="155" />
        </mxCell>
        <mxCell id="spawn" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemySpawnerManager::&lt;br&gt;SpawnWave()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;CurrentWave &amp;lt; SpawnWaves.Num() 时：清空列表；&lt;br&gt;遍历 FSpawnCharacterData，读取 SpawnPoint；&lt;br&gt;SpawnAIFromClass(..., BehaviorTree=nullptr)；&lt;br&gt;设置 LineMover 两端引用并加入当前列表。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemySpawnerManager.cpp:70&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="405" width="480" height="225" />
        </mxCell>
        <mxCell id="ebegin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyCharacter::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Health = StartingHealth；缓存 World / Player；&lt;br&gt;SpawnerManager 先置 nullptr。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemyCharacter.cpp:38&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="710" width="480" height="180" />
        </mxCell>
        <mxCell id="damage" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyCharacter::&lt;br&gt;DamageEnemy()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Health -= BulletDamage；可选伤害音效；&lt;br&gt;调用 IsDead()，只有死亡才继续下列三步。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemyCharacter.cpp:68&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="175" />
        </mxCell>
        <mxCell id="dead" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyCharacter::&lt;br&gt;IsDead()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;返回 Health &amp;lt;= 0；&lt;br&gt;伤害函数与波次检查都会查询。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemyCharacter.cpp:63&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="425" width="480" height="160" />
        </mxCell>
        <mxCell id="killed" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;KilledEnemy()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;先 Combo += 1；&lt;br&gt;Score += ScoreIncrease * Combo。&lt;br&gt;此处只是积分状态更新。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:329&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="660" width="480" height="180" />
        </mxCell>
        <mxCell id="update" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemySpawnerManager::&lt;br&gt;UpdateEnemies()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;DamageEnemy 死亡分支先补取 Player-&amp;gt;GetSpawnManager()；&lt;br&gt;调用本函数从后向前 RemoveAt 无效/死亡敌人；&lt;br&gt;然后 DamageEnemy 中 Destroy() 该敌人。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemySpawnerManager.cpp:110&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="920" width="480" height="205" />
        </mxCell>
        <mxCell id="tick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemySpawnerManager::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;每帧遍历 CurrentWaveCharacters；&lt;br&gt;存在有效且 !IsDead() 的敌人 → 当前波未完成；&lt;br&gt;全清空 → CurrentWave += 1 → SpawnWave()。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemySpawnerManager.cpp:42&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="180" width="480" height="205" />
        </mxCell>
        <mxCell id="get" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemySpawnerManager::&lt;br&gt;GetWaveCharacters()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;先调用 UpdateEnemies()；&lt;br&gt;返回当前波次存活/有效列表的副本。&lt;br&gt;AProjectile::Tick 调用此查询。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemySpawnerManager.cpp:122&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="455" width="480" height="195" />
        </mxCell>
        <mxCell id="end" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;SpawnWave 的完成分支&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;CurrentWave 已越过 SpawnWaves 时：&lt;br&gt;只有 GoToDemoOnComplete=true 才调用&lt;br&gt;UGameplayStatics::OpenLevel(World, LevelToComplete)。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="725" width="480" height="195" />
        </mxCell>
        <mxCell id="edge1" value="直接调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="spbegin" target="spawn">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="UE 调度；与返回后赋字段顺序需运行核验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="spawn" target="ebegin">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="死亡判定" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="damage" target="dead">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
