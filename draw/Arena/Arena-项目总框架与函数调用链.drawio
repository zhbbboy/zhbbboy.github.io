        <mxCell id="projectile" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;投射物分支 → 06 页&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;World-&amp;gt;SpawnActor&amp;lt;AProjectile&amp;gt;()；&lt;br&gt;ProjectileSpawned-&amp;gt;BulletDamage = BulletDamage。&lt;br&gt;碰撞/伤害随后由 AProjectile::Tick 处理。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Weapon.cpp:88（Fire 内部投射物分支）&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
