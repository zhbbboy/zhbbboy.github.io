          <mxGeometry as="geometry" x="600" y="480" width="480" height="205" />
        </mxCell>
        <mxCell id="jasset" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;跳板与交互的资产边界&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BP_JumpPad：Mesh、碰撞与 JumpForce；&lt;br&gt;BP_TestInteraction：组件挂载及 Activated/Enter/Exit 接线；&lt;br&gt;这些配置尚未在编辑器中读取。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="850" width="480" height="215" />
        </mxCell>
        <mxCell id="dbegin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ADamageZone::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BoxCollider 绑定 Begin/EndOverlap；&lt;br&gt;缓存 World 和 Player。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/DamageZone.cpp:39&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="180" width="480" height="190" />
        </mxCell>
        <mxCell id="dcallbacks" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;OnComponentBeginOverlap / EndOverlap&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;仅玩家进入时 PlayerInside = true；&lt;br&gt;仅玩家离开时 PlayerInside = false。&lt;br&gt;碰撞通道及实际组件响应需核验。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/DamageZone.cpp:68、81&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="480" width="480" height="205" />
        </mxCell>
        <mxCell id="dtick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ADamageZone::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;PlayerInside 且 Player 有效：CurrentDamageTime 减时间；&lt;br&gt;&amp;lt;= 0 → 重置为 PlayerDamageTime；&lt;br&gt;Player-&amp;gt;TookDamage(PlayerDamage, GetActorLocation())。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/DamageZone.cpp:51&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
