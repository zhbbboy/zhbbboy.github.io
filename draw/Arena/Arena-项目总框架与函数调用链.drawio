        <mxCell id="subtitle" value="本页展示职责与主要链路；实线标签明确关键函数，虚线不表示顺序执行。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
        </mxCell>
        <mxCell id="legend" value="实线：直接调用/分支步骤　蓝虚线：UE 调度/输入/委托　灰点线：状态或引用　橙虚线：蓝图待确认" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="115" width="1640" height="32" />
        </mxCell>
        <mxCell id="footer" value="当前源码快照 2026-10-11 · 文件位置相对 BoomerShooter/Source/BoomerShooter/ · 未执行 PIE · 阅读顺序见 00 页" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="entry" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;Unreal 引擎 / 配置入口&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BoomerShooter 模块注册；默认地图 Menu。&lt;br&gt;GlobalDefaultGameMode 指向 BP_GameMode。&lt;br&gt;02 页详解初始化；蓝图父类/地图覆盖待核验。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf0f5;strokeColor=#8492a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="160" />
        </mxCell>
        <mxCell id="player" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;输入：SetupPlayerInputComponent / Move / Look / Dash&lt;br&gt;武器：UpdateWeapon / FireInputStart&lt;br&gt;状态：TookDamage / KilledEnemy / Tick&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.h/.cpp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="410" width="480" height="170" />
        </mxCell>
        <mxCell id="weapon" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AWeapon&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;SetFirePressed 改变状态&lt;br&gt;Tick → Fire：射线或投射物&lt;br&gt;SpawnWeapon 挂到玩家相机&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Weapon.h/.cpp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="410" width="480" height="170" />
        </mxCell>
        <mxCell id="manager" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemySpawnerManager&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BeginPlay → SpawnWave&lt;br&gt;Tick 检查存活 → 推进波次&lt;br&gt;GetWaveCharacters → UpdateEnemies&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemySpawnerManager.h/.cpp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="410" width="480" height="170" />
        </mxCell>
        <mxCell id="projectile" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AProjectile&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BeginPlay 缓存玩家/管理器&lt;br&gt;Tick → SweepSingleByObjectType&lt;br&gt;Rocket → DamageEnemy 或 TookDamage&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Projectile.h/.cpp&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="710" width="480" height="165" />
        </mxCell>
        <mxCell id="enemy" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyCharacter&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;DamageEnemy → IsDead&lt;br&gt;死亡 → KilledEnemy + UpdateEnemies + Destroy&lt;br&gt;AIController::Tick 导航；攻击组件单独 Tick&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/ + 08 页&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="710" width="480" height="165" />
        </mxCell>
        <mxCell id="level" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;关卡 / 组件 / 界面&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;InteractionPoint → 委托 → 蓝图&lt;br&gt;JumpPad → LaunchCharacter；DamageZone → TookDamage&lt;br&gt;HUD 查询 GetHealth01 / GetScoreText 等&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;10、11、12 页；UI 绑定待确认&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="710" width="480" height="165" />
        </mxCell>
        <mxCell id="edge1" value="UE 调度 / 玩家类待蓝图核验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#bd8b32;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="player">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="关卡实例 → BeginPlay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="manager">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="切枪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="player" target="weapon">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
