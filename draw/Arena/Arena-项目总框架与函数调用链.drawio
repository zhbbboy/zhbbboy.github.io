  <diagram id="p09" name="08 AI 导航与攻击组件">
    <mxGraphModel dx="1720" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="08 AI 导航与攻击组件" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#253349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1640" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="AIController 处理导航；射击和自爆由独立组件的 TickComponent 处理，具体挂载关系需检查敌人蓝图。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
        </mxCell>
        <mxCell id="legend" value="实线：直接调用/分支步骤　蓝虚线：UE 调度/输入/委托　灰点线：状态或引用　橙虚线：蓝图待确认" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="115" width="1640" height="32" />
        </mxCell>
        <mxCell id="footer" value="当前源码快照 2026-10-11 · 文件位置相对 BoomerShooter/Source/BoomerShooter/ · 未执行 PIE · 阅读顺序见 00 页" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="begin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyAIController::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;缓存 World 和 Player；&lt;br&gt;感知组件 AddDynamic 两行被注释。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemyAIController.cpp:37&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="175" />
        </mxCell>
        <mxCell id="tick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AEnemyAIController::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Player 有效 → 取得 ParentCharacter；&lt;br&gt;按 EnemyType 分支选择 MoveToLocation。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/EnemyAIController.cpp:60&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="425" width="480" height="175" />
        </mxCell>
        <mxCell id="line" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;EEnemyType::LineMover&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;FMath::ClosestPointOnSegment(玩家位置, 起点, 终点)；&lt;br&gt;MoveToLocation(TargetLocation)。&lt;br&gt;两端引用由管理器 SpawnWave 赋值。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="670" width="480" height="190" />
        </mxCell>
        <mxCell id="other" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;Chaser / Suicide / Stationary 的实际分支&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;距离 &amp;lt;= MinFollowDistance：仅 Chaser/Suicide&lt;br&gt;向玩家脚下 LineTrace，命中后 MoveToLocation；&lt;br&gt;距离更大：MoveToLocation(自身位置)。&lt;br&gt;Stationary 在近距离分支没有额外导航调用。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="940" width="480" height="230" />
        </mxCell>
        <mxCell id="shootbegin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UShootProjectile::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;缓存 World；组件构造函数启用 Tick。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/ShootProjectile.cpp:36&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="175" />
        </mxCell>
        <mxCell id="shoot" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UShootProjectile::&lt;br&gt;TickComponent()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;CurrentShootTimer += DeltaTime；&lt;br&gt;达到 ShootTime 且 Projectile 有效 → SpawnActor；&lt;br&gt;BulletDamage = Damage，播放 ShootAudio。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/ShootProjectile.cpp:42&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="425" width="480" height="205" />
        </mxCell>
        <mxCell id="rocket" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;敌方投射物的后续链 → 06 页&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;组件位置/旋转用于生成；&lt;br&gt;EnemyBullet / ProjectileType 并未在此代码赋值；&lt;br&gt;若蓝图为敌方 Rocket：Tick → TookDamage。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="710" width="480" height="195" />
        </mxCell>
        <mxCell id="explodebegin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UExplodeWithinRange::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;缓存 World 和 Player；组件构造函数启用 Tick。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/ExplodeWithinRange.cpp:35&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="180" width="480" height="175" />
        </mxCell>
        <mxCell id="explode" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UExplodeWithinRange::&lt;br&gt;TickComponent()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;玩家距离 &amp;lt;= ExplodeRadius 且 Explosion 有效：&lt;br&gt;SpawnActor(Explosion) → TookDamage(PlayerDamage)&lt;br&gt;→ GetOwner()-&amp;gt;Destroy()。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Enemies/ExplodeWithinRange.cpp:42&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="425" width="480" height="205" />
        </mxCell>
        <mxCell id="bypass" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;自爆路径与普通敌人死亡不同&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;此组件没有调用 AEnemyCharacter::DamageEnemy，&lt;br&gt;也没有直接调用 KilledEnemy / UpdateEnemies。&lt;br&gt;管理器之后 Tick 会跳过已无效的角色；查询也会清理。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="710" width="480" height="205" />
        </mxCell>
        <mxCell id="edge1" value="缓存 Player / UE 每帧调度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#8c96a5;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=1 4;" edge="1" parent="1" source="begin" target="tick">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="LineMover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="tick" target="line">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="其他" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;exitX=0;exitY=0.6;entryX=0;entryY=0.4;" edge="1" parent="1" source="tick" target="other">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="20" y="530" />
              <mxPoint x="20" y="1030" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge4" value="UE 每帧调度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="shootbegin" target="shoot">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" value="SpawnActor → 投射物生命周期" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="shoot" target="rocket">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge6" value="UE 每帧调度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="explodebegin" target="explode">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge7" value="当前代码行为" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="explode" target="bypass">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="perception" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;感知回调当前状态&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;OnPreceptionUpdated / OnTargetPerceptionUpdated 只输出调试文字；BeginPlay 中绑定被注释。&lt;br&gt;SpawnAIFromClass 传入的行为树为 nullptr；不能因此断言蓝图里也没有行为树或其他附加逻辑。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="1010" width="1040" height="160" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p10" name="09 玩家受伤与 HUD 查询">
    <mxGraphModel dx="1720" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="09 玩家受伤与 HUD 查询" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#253349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1640" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="左列写状态，中央维护计时/表现，右列提供 BlueprintCallable 查询；UI 实际接线未读取。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
        </mxCell>
        <mxCell id="legend" value="实线：直接调用/分支步骤　蓝虚线：UE 调度/输入/委托　灰点线：状态或引用　橙虚线：蓝图待确认" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="115" width="1640" height="32" />
        </mxCell>
        <mxCell id="footer" value="当前源码快照 2026-10-11 · 文件位置相对 BoomerShooter/Source/BoomerShooter/ · 未执行 PIE · 阅读顺序见 00 页" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="sources" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;TookDamage 的 C++ 调用者&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;AProjectile::Tick：敌方 Rocket 命中玩家；&lt;br&gt;UExplodeWithinRange::TickComponent：近距离自爆；&lt;br&gt;ADamageZone::Tick：玩家在区内，伤害间隔完成。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="185" />
        </mxCell>
        <mxCell id="took" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;TookDamage()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Combo = 0；Health -= Damage；播放伤害音效；&lt;br&gt;根据相机前/右向量点积，设置四向提示计时；&lt;br&gt;Health &amp;lt;= 0 → OpenLevel(LevelToLoadOnDeath)。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:335&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="450" width="480" height="220" />
        </mxCell>
        <mxCell id="killed" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;KilledEnemy()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;敌人死亡传入 PlayerScoreIncreaseOnKilled；&lt;br&gt;Combo 增加；Score 乘当前 Combo 累加。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:329&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="760" width="480" height="190" />
        </mxCell>
        <mxCell id="tick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;LevelTimer 每帧累加；&lt;br&gt;DamageDirectionUI 四个计时器减 DeltaTime；&lt;br&gt;相机 roll / bob 随角色速度变化。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:287&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="185" />
        </mxCell>
        <mxCell id="playerget" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;玩家公开查询接口&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;GetHealth01() = Health / MaxHealth&lt;br&gt;GetDamageDirectionUI(DirectionId) = 当前计时 / 淡出时间&lt;br&gt;GetLevelTimer() / GetComboText() / GetScoreText()&lt;br&gt;GetCurrentWeapon() → 当前武器引用&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:379–405&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="450" width="480" height="220" />
        </mxCell>
        <mxCell id="isshooting" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;IsWeaponShooting()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;CurrentWeapon 有效 → AWeapon::IsShooting()；&lt;br&gt;无效返回 false。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:267&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="760" width="480" height="175" />
        </mxCell>
        <mxCell id="weaponget" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;武器查询接口的真实语义&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;IsShooting()：CurrentShootTime &amp;gt; 0，非 FirePressed；&lt;br&gt;GetCrosshairAngle()：ChangeWeaponTime / 0.3f；&lt;br&gt;GetCrosshairScale()：CrosshairHitTime 驱动缩放；&lt;br&gt;IsFirePressed() 为 private，源码无外部调用者。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Weapon.cpp:68、73、78、83&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
