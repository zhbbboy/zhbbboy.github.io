          <mxGeometry as="geometry" x="40" y="480" width="480" height="245" />
        </mxCell>
        <mxCell id="check4" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;敌人、AI 与攻击组件&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BP_Chaser / Stationary / Suicider / LineMover；&lt;br&gt;AIControllerClass 和控制器 EnemyType；&lt;br&gt;是否挂载 ShootProjectile / ExplodeWithinRange / LookAtTarget。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
