  <diagram id="p01" name="00 学习导航">
    <mxGraphModel dx="1720" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="00 学习导航" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#253349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1640" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="先读总览，再沿页码逐条走函数调用链；每学完一页回到源码解释状态变化。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
        </mxCell>
        <mxCell id="legend" value="实线：直接调用/分支步骤　蓝虚线：UE 调度/输入/委托　灰点线：状态或引用　橙虚线：蓝图待确认" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="115" width="1640" height="32" />
        </mxCell>
        <mxCell id="footer" value="当前源码快照 2026-10-11 · 文件位置相对 BoomerShooter/Source/BoomerShooter/ · 未执行 PIE · 阅读顺序见 00 页" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="step0" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;01 总框架&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;建立玩家、武器、敌人、波次与关卡的全局关系。&lt;br&gt;先理解职责和引用，再看细节。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="180" />
        </mxCell>
        <mxCell id="step1" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;02 启动与生命周期&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;构建/配置入口 → 玩家初始化 → 输入注册。&lt;br&gt;重点：引擎调度与普通函数调用的区别。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="180" />
        </mxCell>
        <mxCell id="step2" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;03 移动、视角、跳跃和 Dash&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;SetupPlayerInputComponent → Move / Look / JumpInput / Dash。&lt;br&gt;重点：继承、输入参数、移动组件。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="180" width="480" height="180" />
        </mxCell>
        <mxCell id="step3" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;04 切枪与武器挂载&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;ChangeWeapon1~4 → UpdateWeapon → SpawnWeapon。&lt;br&gt;重点：对象创建、销毁与双向引用。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="400" width="480" height="180" />
        </mxCell>
        <mxCell id="step4" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;05 开火与射线命中&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;FireInputStart → SetFirePressed；Tick → Fire。&lt;br&gt;重点：状态驱动、冷却、多发与散布。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="400" width="480" height="180" />
        </mxCell>
        <mxCell id="step5" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;06 投射物命中&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;SpawnActor → BeginPlay；Tick → Sweep → 伤害。&lt;br&gt;重点：敌我标记、Rocket/Bounce/Standard 分支。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="400" width="480" height="180" />
        </mxCell>
        <mxCell id="step6" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;07 敌人死亡、计分与波次&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;DamageEnemy → IsDead → KilledEnemy / UpdateEnemies。&lt;br&gt;重点：跨对象调用与下一帧波次推进。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="620" width="480" height="180" />
        </mxCell>
        <mxCell id="step7" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;08 AI 导航与攻击组件&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;EnemyAIController::Tick / ShootProjectile::TickComponent。&lt;br&gt;重点：Controller 与可挂载组件职责。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="620" width="480" height="180" />
        </mxCell>
        <mxCell id="step8" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;09 玩家受伤与 HUD 查询&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;TookDamage → 血量/连击/方向提示 → OpenLevel。&lt;br&gt;重点：数据写入与 UI 查询分离。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fceaea;strokeColor=#cb7171;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="620" width="480" height="180" />
        </mxCell>
        <mxCell id="step9" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;10 交互、跳板、伤害区&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;委托广播、Overlap 回调、定时区域伤害。&lt;br&gt;重点：事件链与距离状态。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="840" width="480" height="180" />
        </mxCell>
        <mxCell id="step10" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;11 工具组件与标记 Actor&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;LookAtTarget / MoveBetweenPoints / 位置标记。&lt;br&gt;重点：组件 Tick 与真实变换目标。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="840" width="480" height="180" />
        </mxCell>
        <mxCell id="step11" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;12 蓝图边界与函数索引&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;核验按键、武器参数、AI/组件挂载、HUD 和地图。&lt;br&gt;完整函数文件/行号见同目录学习指南。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="840" width="480" height="180" />
        </mxCell>
        <mxCell id="method" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;每一页的学习动作&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;① 找到 .h 声明 → ② 按节点行号读 .cpp → ③ 追调用者/被调用者 → ④ 找蓝图赋值 → ⑤ 在 PIE 验证。&lt;br&gt;先完成 02 → 04 → 05 → 07，即可读通最小战斗闭环。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1080" width="1640" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p02" name="01 总框架">
    <mxGraphModel dx="1720" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
