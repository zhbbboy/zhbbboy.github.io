        <mxCell id="input" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;SetupPlayerInputComponent()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BindAction：Move/Look/Dash 使用 Triggered；&lt;br&gt;Jump 使用 Started，松开 Completed → StopJumping。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:105&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="1040" height="160" />
        </mxCell>
        <mxCell id="mapping" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;输入资产（待核验）&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;IMC_Default + IA_Move/Look/Jump/Dash；&lt;br&gt;真实键位、Trigger 配置和字段赋值未读取。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="180" width="480" height="160" />
        </mxCell>
        <mxCell id="move" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;Move()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Value.Get&amp;lt;FVector2D&amp;gt;() → MovementVector；&lt;br&gt;AddMovementInput(前向, Y)；&lt;br&gt;AddMovementInput(右向, X)。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:138&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="410" width="480" height="185" />
        </mxCell>
        <mxCell id="look" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;Look()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Value.Get&amp;lt;FVector2D&amp;gt;()；&lt;br&gt;AddControllerYawInput(X)；&lt;br&gt;AddControllerPitchInput(Y)。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:149&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="410" width="480" height="185" />
        </mxCell>
        <mxCell id="jump" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;JumpInput()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;CanJump() 决定是否播放跳跃音效；&lt;br&gt;随后调用 ACharacter::Jump()。&lt;br&gt;JumpAction Completed → StopJumping()。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:160&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="410" width="480" height="185" />
        </mxCell>
        <mxCell id="dash" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;Dash()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;CanDash 为 true 才执行；&lt;br&gt;按 MovementVector 或前向计算 LaunchDir；&lt;br&gt;LaunchCharacter(..., false, false)，CanDash=false。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:173&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="685" width="480" height="195" />
        </mxCell>
        <mxCell id="land" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;Landed()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;落地回调：CanDash = true；&lt;br&gt;可选播放 JumpLandAudio。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:277&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="685" width="480" height="195" />
        </mxCell>
        <mxCell id="tick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;LevelTimer += DeltaTime；相机 roll / bob；&lt;br&gt;DamageDirectionUI[4] 随时间衰减。&lt;br&gt;此 Tick 负责表现和计时，不直接调用移动输入函数。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:287&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="685" width="480" height="195" />
        </mxCell>
        <mxCell id="edge1" value="MoveAction Triggered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;exitX=0.12;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="input" target="move">
