  <diagram id="p05" name="04 切枪与武器挂载">
    <mxGraphModel dx="1720" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="04 切枪与武器挂载" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#253349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1640" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="武器切换会销毁旧实例并生成新实例；Weapons 数组来自蓝图默认值。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="76" width="1640" height="36" />
        </mxCell>
        <mxCell id="legend" value="实线：直接调用/分支步骤　蓝虚线：UE 调度/输入/委托　灰点线：状态或引用　橙虚线：蓝图待确认" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="115" width="1640" height="32" />
        </mxCell>
        <mxCell id="footer" value="当前源码快照 2026-10-11 · 文件位置相对 BoomerShooter/Source/BoomerShooter/ · 未执行 PIE · 阅读顺序见 00 页" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1190" width="1640" height="26" />
        </mxCell>
        <mxCell id="begin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;首次调用 UpdateWeapon(1)。&lt;br&gt;索引 1 是第二个槽；具体武器类取决于 Weapons 配置。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:54&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="180" width="480" height="175" />
        </mxCell>
        <mxCell id="slots" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;切枪输入的四个回调&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;ChangeWeaponSlot0 → ChangeWeapon1 → UpdateWeapon(0)&lt;br&gt;ChangeWeaponSlot1 → ChangeWeapon2 → UpdateWeapon(1)&lt;br&gt;ChangeWeaponSlot2 → ChangeWeapon3 → UpdateWeapon(2)&lt;br&gt;ChangeWeaponSlot3 → ChangeWeapon4 → UpdateWeapon(3)&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:105、204、209、214、219&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="420" width="480" height="290" />
        </mxCell>
        <mxCell id="update" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;ABoomerShooterCharacter::&lt;br&gt;UpdateWeapon()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;先检查 World 和 WeaponId 范围；&lt;br&gt;从 FirstPersonCameraComponent 取生成位置/旋转；&lt;br&gt;若 CurrentWeapon 有效，Destroy() 并置空。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:240&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#5b8fc9;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="180" width="480" height="190" />
        </mxCell>
        <mxCell id="spawnactor" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;UWorld::SpawnActor&amp;lt;AWeapon&amp;gt;()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Weapons[WeaponId] 指定武器类；&lt;br&gt;AlwaysSpawn；返回对象保存到 CurrentWeapon。&lt;br&gt;接着 CurrentWeapon-&amp;gt;SpawnWeapon(this)。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Character/BoomerShooterCharacter.cpp:262–263&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf0f5;strokeColor=#8492a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="440" width="480" height="190" />
        </mxCell>
        <mxCell id="spawnweapon" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AWeapon::&lt;br&gt;SpawnWeapon()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;Character = TargetCharacter；缓存 PlayerController；&lt;br&gt;ChangeWeaponTime = 0.3f；&lt;br&gt;AttachToComponent(玩家相机, GripPoint)；&lt;br&gt;设置相对位置/旋转/缩放与 TargetRelativeLocation。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Weapon.cpp:236&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="700" width="480" height="225" />
        </mxCell>
        <mxCell id="wbegin" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AWeapon::&lt;br&gt;BeginPlay()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;World = GetWorld()；&lt;br&gt;由 UE 在 Actor 生命周期中调用。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Weapon.cpp:57&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="180" width="480" height="175" />
        </mxCell>
        <mxCell id="wtick" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;AWeapon::&lt;br&gt;Tick()&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;利用 Character、相机、移动组件计算武器 sway；&lt;br&gt;弹簧位置和 roll；更新射击时间、切枪动画计时、准星命中计时。&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#627086;margin-top:8px&quot;&gt;Weapon/Weapon.cpp:264&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#489a79;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="440" width="480" height="190" />
        </mxCell>
        <mxCell id="state" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;持有关系与切枪状态&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;玩家 → CurrentWeapon；武器 → Character / PlayerController。&lt;br&gt;状态存在武器实例：FirePressed、CurrentShootTime、CrosshairHitTime、ChangeWeaponTime。&lt;br&gt;源码没有独立弹药/换弹系统。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="700" width="480" height="225" />
        </mxCell>
        <mxCell id="edge1" value="默认槽 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="begin" target="update">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" value="索引 0~3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;exitX=1;exitY=0.3;entryX=0;entryY=0.85;" edge="1" parent="1" source="slots" target="update">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" value="销毁旧枪之后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b617c;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;" edge="1" parent="1" source="update" target="spawnactor">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
