        <mxCell id="check1" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;输入与玩家&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;BP_FirstPersonCharacter 的 DefaultMappingContext / Action 字段；&lt;br&gt;IMC_Default 的真实键位与 Trigger；&lt;br&gt;Weapons 数组、MaxHealth、DashVelocity。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99c42;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
