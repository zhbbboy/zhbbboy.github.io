        <mxCell id="edge3" value="UE 每帧调度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#4b83c1;fontColor=#42536a;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;jettySize=auto;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="movebegin" target="movetick">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="learn" value="&lt;div style=&quot;font-size:19px;font-weight:bold;line-height:1.3&quot;&gt;阅读组件时的固定检查&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5;margin-top:8px&quot;&gt;先看继承（USceneComponent / AActor）、构造函数 Tick 开关，再看 BeginPlay 与 TickComponent，最后查看 UPROPERTY 暴露的参数。&lt;br&gt;特别核对 SetRelativeLocation / SetWorldRotation / GetOwner()-&amp;gt;SetActorRotation 各自修改哪个对象。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#9e85bf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=10;spacingBottom=10;fontFamily=Microsoft YaHei;fontColor=#253349;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1080" width="1640" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
