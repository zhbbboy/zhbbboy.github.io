        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="update" target="forward">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="forward" target="display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;复习 / 扩展入口&lt;/b&gt;&lt;br&gt;扩展入口：换弹动画 / 取消换弹 / 拾取弹药在 Weapon 的状态与 Timer 流程；HUD 只接收结果。当前 Die / WinGame 停止开火，但未显式取消换弹 Timer。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
