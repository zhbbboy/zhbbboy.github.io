  <diagram id="myarena-05" name="05 子弹命中与敌人受伤">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MyArena  /  05  子弹命中与敌人受伤" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="碰撞不是玩家或武器 Tick 主动调用；它由 ProjectileMovement 运动产生的 OnComponentHit 委托触发。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线＝调用 / 同函数步骤　蓝虚线＝UE 调度 / 输入 / 委托 / Timer　灰点线＝引用 / 状态依赖　橙虚线＝蓝图配置待核实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="A  子弹初始化与碰撞入口" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="B  敌人伤害与命中反馈" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="630" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="C  特效、销毁与清波衔接" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="construct" value="&lt;b&gt;AMyProjectile()：创建组件&lt;/b&gt;&lt;br&gt;Sphere 为碰撞根；Mesh 关闭碰撞&lt;br&gt;ProjectileMovement.UpdatedComponent = Sphere&lt;br&gt;默认速度 3000、无重力、寿命 5 秒&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:12&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="begin" value="&lt;b&gt;Projectile.BeginPlay()&lt;/b&gt;&lt;br&gt;OnComponentHit.AddDynamic → OnProjectileHit&lt;br&gt;IgnoreActorWhenMoving：Instigator / Owner&lt;br&gt;忽略发射玩家与武器&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:43&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="465" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="hit" value="&lt;b&gt;OnProjectileHit(...)&lt;/b&gt;&lt;br&gt;OtherActor → Cast&amp;lt;AMyEnemyCharacter&amp;gt;&lt;br&gt;若有效敌人 → TakeProjectileDamage(Damage)&lt;br&gt;默认 Damage = 25&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:72&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="715" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lifetime" value="&lt;b&gt;未命中：InitialLifeSpan 到期&lt;/b&gt;&lt;br&gt;Actor 存活默认 5 秒后由 UE 销毁&lt;br&gt;Projectile 的 Actor Tick 关闭，不轮询碰撞&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:39&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#8796a8;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="990" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="damage" value="&lt;b&gt;Enemy.TakeProjectileDamage(Damage)&lt;/b&gt;&lt;br&gt;正在销毁 / 已死 / 非有限数 / 非正伤害 → false&lt;br&gt;有效伤害 → Clamp 扣血到 [0, MaxHealth]&lt;br&gt;血量 &amp;lt;= 0 → Destroy；最后返回 true&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyCharacter.cpp:46&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="dead" value="&lt;b&gt;生命归零 → Enemy.Destroy()&lt;/b&gt;&lt;br&gt;没有直接调用 Spawner 的死亡回调&lt;br&gt;敌人引用随后会被 IsValid 判为无效&lt;br&gt;不在这里立即递减波次计数&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyCharacter.cpp:71&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="495" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="notify" value="&lt;b&gt;TakeProjectileDamage 返回 true 后&lt;/b&gt;&lt;br&gt;Projectile 从 GetInstigator() 找发射玩家&lt;br&gt;Player.NotifyEnemyHit() → HUD.ShowHitMarker()&lt;br&gt;是有效伤害反馈，非仅击杀反馈&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:77&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#519779;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="740" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="hide" value="&lt;b&gt;命中标记自动隐藏&lt;/b&gt;&lt;br&gt;ShowHitMarker → Visible&lt;br&gt;Timer 0.15 秒 → HideHitMarker() → Hidden&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyHUDWidget.cpp:74&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#519779;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="1020" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="impactfx" value="&lt;b&gt;命中位置播放反馈&lt;/b&gt;&lt;br&gt;ImpactEffect &amp;amp;&amp;amp; bBlockingHit → Niagara 特效&lt;br&gt;ImpactSound &amp;amp;&amp;amp; bBlockingHit → 命中音效&lt;br&gt;命中墙体也会走这里&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:88&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="destroyprojectile" value="&lt;b&gt;OnProjectileHit 最后 Destroy()&lt;/b&gt;&lt;br&gt;无论是否命中敌人、伤害是否有效&lt;br&gt;完成本次命中特效 / 声音后销毁子弹&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.cpp:109&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="505" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;后续 UE Tick → Spawner 清理&lt;/b&gt;&lt;br&gt;CleanupDeadEnemies：倒序遍历数组&lt;br&gt;RemoveAt 无效引用 → 更新剩余敌人 HUD&lt;br&gt;Tick 再检查是否清波；详见 08&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.cpp:146&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="755" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="example" value="&lt;b&gt;用 C++ 默认值复盘一次击杀&lt;/b&gt;&lt;br&gt;敌人 100 血；子弹 25 伤害 → 4 次有效命中&lt;br&gt;最后一次仍可触发命中标记&lt;br&gt;数量变化由刷怪器 Tick 检测，非子弹修改" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1020" width="440" height="135" as="geometry" />
        </mxCell>
