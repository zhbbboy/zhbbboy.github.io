  <diagram id="myarena-00" name="00 学习导航">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MyArena  /  00  学习导航" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="按页签逐个复习：先看职责与引用，再读触发条件、函数调用和状态变化。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线＝调用 / 同函数步骤　蓝虚线＝UE 调度 / 输入 / 委托 / Timer　灰点线＝引用 / 状态依赖　橙虚线＝蓝图配置待核实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="topic0" value="&lt;b&gt;01 总框架&lt;/b&gt;&lt;br&gt;8 个类的职责、对象引用和战斗闭环&lt;br&gt;&lt;br&gt;谁拥有数据？谁调用谁？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic1" value="&lt;b&gt;02 启动与生命周期&lt;/b&gt;&lt;br&gt;地图 → GameMode → 玩家 → HUD / 武器&lt;br&gt;&lt;br&gt;BeginPlay、输入绑定、Tick 谁触发？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#8796a8;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="185" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic2" value="&lt;b&gt;03 输入与移动&lt;/b&gt;&lt;br&gt;Move / Look / Jump / Dash 的输入回调&lt;br&gt;&lt;br&gt;冲刺状态何时消耗、何时恢复？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="185" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic3" value="&lt;b&gt;04 开火、连射与瞄准&lt;/b&gt;&lt;br&gt;StartFire → Tick → Fire → SpawnActor&lt;br&gt;&lt;br&gt;相机射线与实体子弹分别做什么？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic4" value="&lt;b&gt;05 子弹命中与敌人受伤&lt;/b&gt;&lt;br&gt;组件碰撞委托 → 扣血 → 命中反馈&lt;br&gt;&lt;br&gt;敌人死亡如何传递给波次系统？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="430" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic5" value="&lt;b&gt;06 换弹与弹药 HUD&lt;/b&gt;&lt;br&gt;StartReload → Timer → FinishReload&lt;br&gt;&lt;br&gt;按住开火时为何换弹后继续连射？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="430" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic6" value="&lt;b&gt;07 AI、玩家受伤与失败&lt;/b&gt;&lt;br&gt;AI Tick → 追击 / 攻击 → ReceiveEnemyDamage&lt;br&gt;&lt;br&gt;死亡后哪些行为被停止？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic7" value="&lt;b&gt;08 波次、胜利与重开&lt;/b&gt;&lt;br&gt;Spawner Tick → 清理 → 下一波 / WinGame&lt;br&gt;&lt;br&gt;何时算清波？重开如何恢复状态？" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="675" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="topic8" value="&lt;b&gt;09 蓝图检查与扩展路线&lt;/b&gt;&lt;br&gt;配置检查、数据归属、功能扩展位置&lt;br&gt;&lt;br&gt;从当前实现逐步扩成自己的 demo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="675" width="560" height="210" as="geometry" />
        </mxCell>
        <mxCell id="method" value="&lt;b&gt;每页都按这 4 步复习&lt;/b&gt;&lt;br&gt;① 打开 .h 看成员与 UPROPERTY。  ② 沿箭头找到 .cpp 的真实函数。&lt;br&gt;③ 说清触发者、前置条件、状态写入与下游调用。  ④ 在编辑器核实蓝图配置，再独立复写这一段。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;复习 / 扩展入口&lt;/b&gt;&lt;br&gt;第一轮：01 → 02 → 04 → 05 → 08，读通射击与清波；第二轮补 03 / 06 / 07 / 09。所有节点、文字和连线可直接编辑。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1720" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="myarena-01" name="01 总框架">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MyArena  /  01  总框架" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="这是当前 C++ 的职责与依赖图；底部列出两条闭环，细节进入后续页签。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线＝调用 / 同函数步骤　蓝虚线＝UE 调度 / 输入 / 委托 / Timer　灰点线＝引用 / 状态依赖　橙虚线＝蓝图配置待核实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ue" value="&lt;b&gt;UE 世界 / GameMode&lt;/b&gt;&lt;br&gt;默认地图：/Game/Test.Test&lt;br&gt;GameMode 选择玩家蓝图为 DefaultPawnClass&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterGameMode.cpp:6&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#8796a8;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="390" height="155" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;Enhanced Input&lt;/b&gt;&lt;br&gt;IMC_Player + 7 个 IA_* 资产&lt;br&gt;Started / Triggered / Completed 回调到玩家&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:107&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="390" height="155" as="geometry" />
        </mxCell>
        <mxCell id="hud" value="&lt;b&gt;UMyHUDWidget  /  展示&lt;/b&gt;&lt;br&gt;由玩家创建并持有 HUDWidget&lt;br&gt;血量 / 弹药 / 波次 / 命中 / 闪红 / 结算&lt;br&gt;HUD 接收数据，不计算伤害或波次&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyHUDWidget.h:18&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#519779;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="840" width="390" height="170" as="geometry" />
        </mxCell>
        <mxCell id="player" value="&lt;b&gt;AMyArenaShooterCharacter  /  玩家枢纽&lt;/b&gt;&lt;br&gt;输入转发；相机与移动；CurrentHealth&lt;br&gt;持有 CurrentWeapon、HUDWidget&lt;br&gt;bIsDead / bHasWon 控制结算&lt;br&gt;UpadteAmmoHUD / UpadteWaveHUD 转发显示&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.h:18&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="470" height="215" as="geometry" />
        </mxCell>
        <mxCell id="weapon" value="&lt;b&gt;AMyWeapon  /  射击与弹药&lt;/b&gt;&lt;br&gt;Owner / Instigator = 玩家；挂到相机&lt;br&gt;Tick 连射、Fire 瞄准、Timer 换弹&lt;br&gt;持有弹匣数、备用数、冷却和开火状态&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.h:17&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="670" width="470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="projectile" value="&lt;b&gt;AMyProjectile  /  实体子弹&lt;/b&gt;&lt;br&gt;Owner = 武器；Instigator = 发射玩家&lt;br&gt;ProjectileMovement 移动，OnComponentHit 命中&lt;br&gt;伤害通过 TakeProjectileDamage 交给敌人&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyProjectile.h:15&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="960" width="470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="spawner" value="&lt;b&gt;AMyEnemySpawner  /  波次调度&lt;/b&gt;&lt;br&gt;EnemyClass / SpawnPoints / Waves&lt;br&gt;维护 CurrentWaveEnemies 和 CurrentWaveIndex&lt;br&gt;Tick 清理无效引用；最后一波清空 → WinGame&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.h:23&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="210" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="enemy" value="&lt;b&gt;AMyEnemyCharacter  /  敌人实体&lt;/b&gt;&lt;br&gt;保存敌人血量，接收子弹伤害&lt;br&gt;生命归零 → Destroy()&lt;br&gt;自动由 AMyEnemyAIController 控制&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyCharacter.h:10&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="560" width="420" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ai" value="&lt;b&gt;AMyEnemyAIController  /  敌人决策&lt;/b&gt;&lt;br&gt;GetPawn() 得到被控制敌人&lt;br&gt;缓存玩家 0；Tick 算距离 / 追击 / 攻击&lt;br&gt;攻击时调用玩家 ReceiveEnemyDamage&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyAIController.h:16&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="940" width="420" height="165" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="UE 生成 / 控制 Pawn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#427cbb;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ue" target="player">
          <mxGeometry relative="1" as="geometry">
