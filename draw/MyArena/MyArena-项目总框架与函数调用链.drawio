        <mxCell id="title" value="MyArena  /  03  输入与移动" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="SetupPlayerInputComponent 只绑定回调；Move / Look / Dash 的业务在玩家类，实际移动由 UE 组件执行。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
