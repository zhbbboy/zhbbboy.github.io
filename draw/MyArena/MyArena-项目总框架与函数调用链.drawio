  <diagram id="myarena-07" name="07 AI、玩家受伤与失败">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MyArena  /  07  AI、玩家受伤与失败" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="当前 AI 是 C++ Tick 的距离判断；未调用行为树，也没有用攻击动画通知触发伤害。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线＝调用 / 同函数步骤　蓝虚线＝UE 调度 / 输入 / 委托 / Timer　灰点线＝引用 / 状态依赖　橙虚线＝蓝图配置待核实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="A  AI 目标与距离决策" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="B  移动 / 攻击与玩家扣血" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="630" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="C  受击反馈与死亡" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="possess" value="&lt;b&gt;敌人自动使用 MyEnemyAIController&lt;/b&gt;&lt;br&gt;AIControllerClass = StaticClass()&lt;br&gt;AutoPossessAI = PlacedInWorldOrSpawned&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyCharacter.cpp:12&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="begin" value="&lt;b&gt;AI.BeginPlay() 缓存玩家 0&lt;/b&gt;&lt;br&gt;GetPlayerCharacter(GetWorld(), 0)&lt;br&gt;Cast&amp;lt;AMyArenaShooterCharacter&amp;gt; → PlayerCharacter&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyAIController.cpp:13&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="tick" value="&lt;b&gt;UE 每帧 → AI.Tick(DeltaTime)&lt;/b&gt;&lt;br&gt;玩家无效 → 返回；攻击冷却减至最低 0&lt;br&gt;GetPawn() 无效 → 返回&lt;br&gt;计算敌人 Pawn 与玩家位置的距离&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyAIController.cpp:21&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="655" width="440" height="155" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;DistanceToPlayer &amp;gt; AttackRange？&lt;/b&gt;&lt;br&gt;默认 AttackRange = 150&lt;br&gt;按中心点距离判断" style="shape=rhombus;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=center;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="95" y="965" width="410" height="170" as="geometry" />
        </mxCell>
        <mxCell id="move" value="&lt;b&gt;超出范围：MoveToActor()&lt;/b&gt;&lt;br&gt;目标为玩家；AcceptanceRadius 默认 50&lt;br&gt;寻路需要编辑器中可用的导航配置&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyAIController.cpp:43&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="attack" value="&lt;b&gt;范围内：StopMovement()&lt;/b&gt;&lt;br&gt;若 CurrentAttackCooldown &amp;lt;= 0&lt;br&gt;ReceiveEnemyDamage(AttackDamage)&lt;br&gt;然后冷却重设为 AttackCooldown&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemyAIController.cpp:50&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffeded;strokeColor=#cb6b6b;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="490" width="440" height="155" as="geometry" />
        </mxCell>
        <mxCell id="damage" value="&lt;b&gt;Player.ReceiveEnemyDamage(Damage)&lt;/b&gt;&lt;br&gt;死亡 / 胜利 / Damage &amp;lt;= 0 → 返回&lt;br&gt;CurrentHealth = Clamp(CurrentHealth - Damage)&lt;br&gt;默认单次 AttackDamage = 20，冷却 1 秒&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:288&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="770" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="zero" value="&lt;b&gt;扣血后：CurrentHealth &amp;lt;= 0？&lt;/b&gt;&lt;br&gt;是 → Die()&lt;br&gt;否 → 等待下一次攻击" style="shape=rhombus;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=center;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="1030" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b&gt;受伤时 HUD / 音效&lt;/b&gt;&lt;br&gt;UpdateHealth + ShowDamageFlash&lt;br&gt;Timer 0.2 秒 → HideDamageFlash&lt;br&gt;DamageSound 且本地控制 → PlaySound2D&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyHUDWidget.cpp:117&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#519779;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="155" as="geometry" />
        </mxCell>
        <mxCell id="die" value="&lt;b&gt;Player.Die()&lt;/b&gt;&lt;br&gt;bIsDead = true&lt;br&gt;CurrentWeapon.StopFire()&lt;br&gt;CharacterMovement.DisableMovement()&lt;br&gt;HUD.ShowGameOver()&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:384&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="650" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;当前终局行为边界&lt;/b&gt;&lt;br&gt;死亡时没有 Pause，也未停止 Spawner / AI Tick&lt;br&gt;后续伤害由 ReceiveEnemyDamage 拒绝&lt;br&gt;Look 无终局判断；RestartGame 可重新加载地图" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1010" width="440" height="160" as="geometry" />
        </mxCell>
