        <mxCell id="e5" value="UpdateAmmoHUD()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="transfer" target="update">
          <mxGeometry relative="1" as="geometry">
