        <mxCell id="gm" value="&lt;b&gt;AMyArenaShooterGameMode()&lt;/b&gt;&lt;br&gt;FClassFinder 查找 BP_MyArenaShooterCharacter&lt;br&gt;找到后设置 DefaultPawnClass&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterGameMode.cpp:6&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#8796a8;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
