          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="A  SpawnWave 生成与跟踪" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="B  Tick 清理与推进" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="630" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="C  胜利与重开" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="begin" value="&lt;b&gt;Spawner.BeginPlay() → SpawnWave()&lt;/b&gt;&lt;br&gt;先缓存玩家 0&lt;br&gt;SpawnWave 检查 EnemyClass / SpawnPoints / Waves&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.cpp:71&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="spawn" value="&lt;b&gt;按本波 EnemyCount 循环生成&lt;/b&gt;&lt;br&gt;SpawnPoints[i % Num] 轮流选择出生点&lt;br&gt;出生点 Z + 100；调整碰撞但总是尝试生成&lt;br&gt;成功敌人加入 CurrentWaveEnemies&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.cpp:98&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="465" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="active" value="&lt;b&gt;设置活动状态并更新波次 HUD&lt;/b&gt;&lt;br&gt;循环内部：bWaveActive = Num() &amp;gt; 0&lt;br&gt;Player.UpadteWaveHUD(Index + 1, Waves.Num, Num)&lt;br&gt;HUD.UpdateWaveInfo 显示波数与存活数&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.cpp:125&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="750" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="empty" value="&lt;b&gt;配置为空 / 零敌人 / 全生成失败&lt;/b&gt;&lt;br&gt;无法形成活动波次，Tick 无法正常推进&lt;br&gt;当前没有自动跳过空波或重试逻辑&lt;br&gt;这是扩展时需要补足的状态边界" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1030" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tick" value="&lt;b&gt;UE 每帧 → Spawner.Tick()&lt;/b&gt;&lt;br&gt;!bWaveActive → 返回&lt;br&gt;CleanupDeadEnemies()&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.cpp:23&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="&lt;b&gt;CleanupDeadEnemies()&lt;/b&gt;&lt;br&gt;倒序遍历 CurrentWaveEnemies&lt;br&gt;!IsValid → RemoveAt；每次变化更新 HUD&lt;br&gt;只跟踪该 Spawner 成功加入数组的敌人&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyEnemySpawner.cpp:146&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="455" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="emptydecision" value="&lt;b&gt;CurrentWaveEnemies.Num() == 0？&lt;/b&gt;&lt;br&gt;否 → 下一帧继续&lt;br&gt;是 → 结束本波，波次索引 +1" style="shape=rhombus;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=center;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="730" width="420" height="175" as="geometry" />
        </mxCell>
        <mxCell id="last" value="&lt;b&gt;CurrentWaveIndex &amp;gt;= Waves.Num()？&lt;/b&gt;&lt;br&gt;否 → SpawnWave() 开始下一波&lt;br&gt;是 → 尝试取得玩家并 WinGame" style="shape=rhombus;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=center;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="1015" width="420" height="175" as="geometry" />
        </mxCell>
        <mxCell id="win" value="&lt;b&gt;Player.WinGame()&lt;/b&gt;&lt;br&gt;已死或已胜 → 返回；否则 bHasWon = true&lt;br&gt;Weapon.StopFire + DisableMovement&lt;br&gt;HUD.ShowVictory()&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:355&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="restart" value="&lt;b&gt;RestartAction → RestartGame()&lt;/b&gt;&lt;br&gt;仅 bIsDead || bHasWon 时通过&lt;br&gt;GetCurrentLevelName(this, true)&lt;br&gt;OpenLevel(this, 当前地图名)&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:403&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
