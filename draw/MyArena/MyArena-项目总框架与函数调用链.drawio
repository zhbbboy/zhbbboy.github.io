        <mxCell id="e9" value="允许重开：等待新的输入事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aA5b5;strokeWidth=1.7;dashed=1;dashPattern=1 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="win" target="restart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="OpenLevel 由 UE 执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#427cbb;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="restart" target="reloadworld">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;复习 / 扩展入口&lt;/b&gt;&lt;br&gt;扩展入口：波次间延时 / Boss / 随机出生点在 Spawner。当前没有分数、掉落、存档或联机状态同步；可以先加波次状态枚举，再逐步扩充 FEnemyWaveData。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1720" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="myarena-09" name="09 蓝图检查与扩展路线">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MyArena  /  09  蓝图检查与扩展路线" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="资产存在能由目录确认；蓝图属性实际赋值、事件图与关卡实例内容需要在 Unreal Editor 中继续核实。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线＝调用 / 同函数步骤　蓝虚线＝UE 调度 / 输入 / 委托 / Timer　灰点线＝引用 / 状态依赖　橙虚线＝蓝图配置待核实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="A  编辑器中逐项检查" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="B  状态归属与当前边界" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="630" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="C  从当前结构扩展 demo" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="bpplayer" value="&lt;b&gt;BP_MyArenaShooterCharacter&lt;/b&gt;&lt;br&gt;父类应为 AMyArenaShooterCharacter&lt;br&gt;DefaultMappingContext / 7 个 InputAction&lt;br&gt;DefaultWeaponClass / HUDWidgetClass / DamageSound&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;Content/BluePrints/BP_MyArenaShooterCharacter.uasset&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="bpcombat" value="&lt;b&gt;BP_MyWeapon / BP_MyProjectile&lt;/b&gt;&lt;br&gt;武器：ProjectileClass、模型、枪口偏移、射速&lt;br&gt;子弹：Damage、碰撞、特效与声音&lt;br&gt;NS_MuzzleFlash / NS_Impact 资产已存在&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;Content/BluePrints/Weapons/&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="495" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="bpworld" value="&lt;b&gt;Test 地图 / BP_MyEnemySpawner&lt;/b&gt;&lt;br&gt;地图是否覆盖 GameMode；Spawner 是否放入地图&lt;br&gt;EnemyClass / SpawnPoints 实例引用 / Waves&lt;br&gt;导航区域、敌人模型与 ABP_MyEnemy 配置&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;Content/BluePrints/Enemies/ + Content/Test.umap&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="755" width="440" height="165" as="geometry" />
        </mxCell>
        <mxCell id="widget" value="&lt;b&gt;WBP_HUD：同名 BindWidget 控件&lt;/b&gt;&lt;br&gt;HealthBar / HealthText / WaveText / EnemyCountText&lt;br&gt;AmmoText / HitMarkerText / GameOverText&lt;br&gt;DamageFlashOverlay / VictoryText&lt;br&gt;检查 GameOverText / VictoryText 初始隐藏&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyHUDWidget.h:24&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="440" height="185" as="geometry" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;状态放在哪个对象？&lt;/b&gt;&lt;br&gt;Player：CurrentHealth、bIsDead、bHasWon&lt;br&gt;Weapon：Ammo、Cooldown、bFirePressed、换弹状态&lt;br&gt;Enemy：CurrentHealth；AI：攻击冷却与目标&lt;br&gt;Spawner：波次索引、活动状态、敌人数组" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="210" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;当前实现需要记住的边界&lt;/b&gt;&lt;br&gt;单玩家索引 0；没有 RPC / Replicated 代码&lt;br&gt;HUD 是主动推送；清波是 Tick 轮询&lt;br&gt;AI 缓存目标，无自动重找；攻击无动画时机&lt;br&gt;死 / 胜仅停开火与移动；没有全局 Pause" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="540" width="440" height="200" as="geometry" />
        </mxCell>
        <mxCell id="naming" value="&lt;b&gt;搜索源码时保留真实拼写&lt;/b&gt;&lt;br&gt;UpadteWaveHUD / UpadteAmmoHUD&lt;br&gt;bIsReoloading&lt;br&gt;类前缀 A 表示 Actor，U 表示 UObject / Widget&lt;br&gt;FEnemyWaveData 是波次数据结构，不是 Actor" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="850" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;第一步：替换内容与参数&lt;/b&gt;&lt;br&gt;换枪模型 / 特效 / 音效 → 武器与子弹蓝图&lt;br&gt;新增敌人样式 → EnemyClass + 敌人蓝图&lt;br&gt;调整波数 / 数量 / 出生点 → Spawner 属性" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;第二步：新增玩法状态&lt;/b&gt;&lt;br&gt;弹药拾取 / 换弹动画 / 切枪 → Weapon + Player&lt;br&gt;波次等待 / Boss / 掉落 → Spawner + Enemy&lt;br&gt;护盾 / 伤害类型 → 玩家与敌人的伤害入口" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="515" width="440" height="175" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;第三步：解耦并复用到新 demo&lt;/b&gt;&lt;br&gt;HealthComponent 统一生命与死亡事件&lt;br&gt;WeaponData / WaveData 配置化&lt;br&gt;委托驱动 HUD 和死亡统计，替代硬引用&lt;br&gt;全局胜败状态逐步移入 GameMode / GameState" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="810" width="440" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="内容参数稳定后再扩玩法" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#c58a38;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="重复逻辑出现后再抽组件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#c58a38;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;复习 / 扩展入口&lt;/b&gt;&lt;br&gt;09 的扩展路线是建议，不是项目现有调用链。修改本图后可直接在 draw.io 保存，并按页导出 PNG / SVG；各资产参数请以编辑器实际配置为准。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1720" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
