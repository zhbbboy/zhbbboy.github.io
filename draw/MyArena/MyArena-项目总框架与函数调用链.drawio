        <mxCell id="l3" value="C  其他输入转发" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="moveinput" value="&lt;b&gt;MoveAction → Triggered / Completed&lt;/b&gt;&lt;br&gt;Triggered → Move(Value)&lt;br&gt;Completed → StopMove(Value)&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:115&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="move" value="&lt;b&gt;Move(Value)&lt;/b&gt;&lt;br&gt;仅检查 bIsDead；读取 FVector2D&lt;br&gt;MovementVector 保存当前输入&lt;br&gt;Y → Forward；X → Right；AddMovementInput&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:209&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="415" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="&lt;b&gt;StopMove(Value)&lt;/b&gt;&lt;br&gt;MovementVector = FVector2D::ZeroVector&lt;br&gt;为下次 Dash 提供方向选择依据&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:229&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="625" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="look" value="&lt;b&gt;LookAction Triggered → Look(Value)&lt;/b&gt;&lt;br&gt;X → AddControllerYawInput&lt;br&gt;-Y → AddControllerPitchInput&lt;br&gt;当前没有死亡 / 胜利状态判断&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:234&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="845" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="jump" value="&lt;b&gt;JumpAction：Started / Completed&lt;/b&gt;&lt;br&gt;Started → ACharacter::Jump&lt;br&gt;Completed → ACharacter::StopJumping&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:140&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3e7;strokeColor=#cf8c40;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dash" value="&lt;b&gt;DashAction Started → Dash(Value)&lt;/b&gt;&lt;br&gt;若 !bCanDash，直接返回&lt;br&gt;有移动输入：合成 Forward * Y + Right * X&lt;br&gt;没有移动输入：朝角色 Forward&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:242&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="415" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="launch" value="&lt;b&gt;LaunchCharacter() 并消耗冲刺&lt;/b&gt;&lt;br&gt;DashDirection * DashVelocity（默认 1500）&lt;br&gt;XYOverride / ZOverride 均为 false&lt;br&gt;bCanDash = false&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:257&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="645" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="land" value="&lt;b&gt;UE 落地回调 → Landed(Hit)&lt;/b&gt;&lt;br&gt;Super::Landed(Hit)&lt;br&gt;bCanDash = true；落地恢复冲刺&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:377&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="925" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fire" value="&lt;b&gt;FireAction：Started / Completed&lt;/b&gt;&lt;br&gt;StartFireInput → Weapon.StartFire&lt;br&gt;StopFireInput → Weapon.StopFire&lt;br&gt;开始开火检查 bIsDead || bHasWon&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:266&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="reload" value="&lt;b&gt;ReloadAction Started → ReloadInput&lt;/b&gt;&lt;br&gt;检查 bIsDead || bHasWon&lt;br&gt;有效武器 → StartReload；详见 06&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:415&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="475" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="restart" value="&lt;b&gt;RestartAction Started → RestartGame&lt;/b&gt;&lt;br&gt;仅死亡或胜利后允许&lt;br&gt;GetCurrentLevelName → OpenLevel；详见 08&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:403&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2edff;strokeColor=#8e71c0;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="690" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;当前输入边界&lt;/b&gt;&lt;br&gt;具体按键在 IMC_Player 中，尚未读取映射值&lt;br&gt;Fire / Reload 检查终局状态&lt;br&gt;Dash 只检查 bCanDash；Jump 直接绑定 UE 函数" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
