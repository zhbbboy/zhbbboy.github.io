  <diagram id="myarena-06" name="06 换弹与弹药 HUD">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MyArena  /  06  换弹与弹药 HUD" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=31;fontColor=#253349;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="保留源码中的拼写：bIsReoloading、UpadteAmmoHUD；图中不会把现有名字替换成理想化接口。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1720" height="34" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线＝调用 / 同函数步骤　蓝虚线＝UE 调度 / 输入 / 委托 / Timer　灰点线＝引用 / 状态依赖　橙虚线＝蓝图配置待核实" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="118" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="source-root" value="源码位置以 Source/MyArenaShooter 为根；参数数值是 C++ 默认值，蓝图可能覆盖。核对：2026-10-11。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#253349;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1328" width="1720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="A  三种触发与开始换弹" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="B  Timer 完成与弹药计算" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="630" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="C  HUD 数据链与连射恢复" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="triggers" value="&lt;b&gt;StartReload() 的触发来源&lt;/b&gt;&lt;br&gt;① ReloadInput：手动换弹&lt;br&gt;② StartFire / Fire：发现空弹匣&lt;br&gt;③ Fire：成功射出最后一发&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:237&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="155" as="geometry" />
        </mxCell>
        <mxCell id="guards" value="&lt;b&gt;StartReload() 的 3 个拒绝条件&lt;/b&gt;&lt;br&gt;已在换弹：bIsReoloading&lt;br&gt;弹匣满：CurrentAmmo &amp;gt;= MagazineSize&lt;br&gt;没有备用弹：ReserveAmmo &amp;lt;= 0&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:239&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="&lt;b&gt;设置换弹状态与单次 Timer&lt;/b&gt;&lt;br&gt;bIsReoloading = true&lt;br&gt;SetTimer(ReloadTimerHandle, FinishReload)&lt;br&gt;默认 ReloadTime = 1.5 秒；false = 不循环&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:262&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="745" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="block" value="&lt;b&gt;换弹期间的开火行为&lt;/b&gt;&lt;br&gt;StartFire 仍会保存 bFirePressed = true&lt;br&gt;StartFire / Fire 返回；Tick 不调用 Fire&lt;br&gt;StopFire 只把 bFirePressed 设为 false" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;Timer 到期 → FinishReload()&lt;/b&gt;&lt;br&gt;NeededAmmo = MagazineSize - CurrentAmmo&lt;br&gt;AmmoToReload = Min(NeededAmmo, ReserveAmmo)&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:271&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="transfer" value="&lt;b&gt;弹药从备用数转入弹匣&lt;/b&gt;&lt;br&gt;CurrentAmmo += AmmoToReload&lt;br&gt;ReserveAmmo -= AmmoToReload&lt;br&gt;bIsReoloading = false&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:277&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="480" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="example" value="&lt;b&gt;例：弹匣 12 / 30，备用 10&lt;/b&gt;&lt;br&gt;NeededAmmo = 18；AmmoToReload = 10&lt;br&gt;换弹后弹匣 22，备用 0&lt;br&gt;没有凭空增加弹药" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="745" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="continue" value="&lt;b&gt;下一帧 Tick 可恢复连射&lt;/b&gt;&lt;br&gt;仍按住 bFirePressed &amp;amp;&amp;amp; 冷却已结束&lt;br&gt;非换弹状态 → Fire()&lt;br&gt;松开按键则不会继续射击&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:45&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="1010" width="440" height="135" as="geometry" />
        </mxCell>
        <mxCell id="update" value="&lt;b&gt;Weapon.UpdateAmmoHUD()&lt;/b&gt;&lt;br&gt;GetOwner() → Cast 为玩家&lt;br&gt;玩家有效 → UpadteAmmoHUD(CurrentAmmo, ReserveAmmo)&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:286&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="forward" value="&lt;b&gt;Player.UpadteAmmoHUD()&lt;/b&gt;&lt;br&gt;HUDWidget 存在 → UpdateAmmo&lt;br&gt;玩家负责转发，弹药实际保存在武器&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:331&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="480" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="display" value="&lt;b&gt;HUD.UpdateAmmo()&lt;/b&gt;&lt;br&gt;AmmoText.SetText：CurrentAmmo / ReserveAmmo&lt;br&gt;显示不改变弹药状态&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyHUDWidget.cpp:60&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#519779;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="745" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="defaults" value="&lt;b&gt;初始化与其他刷新时机&lt;/b&gt;&lt;br&gt;BeginPlay：默认 MagazineSize = 30，Reserve = 90&lt;br&gt;玩家创建武器后先读取一次并更新 HUD&lt;br&gt;每次成功射击 / FinishReload 后刷新&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:26&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1000" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triggers" target="guards">
