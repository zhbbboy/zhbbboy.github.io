        <mxCell id="review" value="&lt;b&gt;复习 / 扩展入口&lt;/b&gt;&lt;br&gt;扩展入口：爆炸 / 穿透在 OnProjectileHit；护盾 / 护甲在 TakeProjectileDamage。要改为死亡事件驱动波次，可新增敌人死亡委托让 Spawner 订阅。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1720" height="92" as="geometry" />
        </mxCell>
