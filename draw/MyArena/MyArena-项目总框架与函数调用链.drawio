              <mxPoint x="530" y="547" />
              <mxPoint x="530" y="472" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="创建 + Update* / Show*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="player" target="hud">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="494" />
              <mxPoint x="570" y="882" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="创建 / 挂载；StartFire / StopFire / StartReload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="player" target="weapon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="UpdateAmmoHUD → UpadteAmmoHUD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#465875;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#465875;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="weapon" target="player">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="713" />
              <mxPoint x="1190" y="472" />
            </Array>
