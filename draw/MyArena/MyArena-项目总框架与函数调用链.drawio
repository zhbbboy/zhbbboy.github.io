          <mxGeometry x="1220" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="press" value="&lt;b&gt;Fire Started → Player.StartFireInput&lt;/b&gt;&lt;br&gt;玩家死亡或胜利 → 返回&lt;br&gt;有效 CurrentWeapon → StartFire()&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyArenaShooterCharacter.cpp:266&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="235" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="startfire" value="&lt;b&gt;Weapon.StartFire()&lt;/b&gt;&lt;br&gt;bFirePressed = true&lt;br&gt;换弹中 → 返回；弹匣空 → StartReload&lt;br&gt;FireCooldown &amp;lt;= 0 → Fire，随后设置间隔&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:210&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="425" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="weapontick" value="&lt;b&gt;UE 每帧 → Weapon.Tick(DeltaTime)&lt;/b&gt;&lt;br&gt;冷却递减并限制最低为 0&lt;br&gt;按住 &amp;amp;&amp;amp; 非换弹 &amp;amp;&amp;amp; 冷却结束 → Fire()&lt;br&gt;本次判断后 FireCooldown = FireInterval&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:34&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="655" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="release" value="&lt;b&gt;Fire Completed → StopFireInput&lt;/b&gt;&lt;br&gt;Weapon.StopFire() → bFirePressed = false&lt;br&gt;Die / WinGame 也会调用 StopFire&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:232&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#4b83ca;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="975" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="guards" value="&lt;b&gt;Fire()：检查前置条件&lt;/b&gt;&lt;br&gt;换弹中 → 返回；空弹匣 → StartReload 后返回&lt;br&gt;验证 MuzzleLocation / ProjectileClass&lt;br&gt;由 Owner 获取玩家，再取 FirstPersonCamera&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:53&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="235" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="&lt;b&gt;相机 LineTraceSingleByObjectType&lt;/b&gt;&lt;br&gt;CameraStart → Forward * 10000 的 CameraEnd&lt;br&gt;检测 Pawn + WorldStatic；忽略玩家与武器&lt;br&gt;命中则 AimPoint = ImpactPoint，否则 CameraEnd&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:102&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="475" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="direction" value="&lt;b&gt;枪口 → AimPoint 计算方向&lt;/b&gt;&lt;br&gt;(AimPoint - MuzzlePosition).GetSafeNormal()&lt;br&gt;近零向量回退 Camera.Forward&lt;br&gt;ShootDirection.Rotation() 得到出生朝向&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:116&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="715" width="440" height="135" as="geometry" />
        </mxCell>
        <mxCell id="spawn" value="&lt;b&gt;SpawnActor&amp;lt;AMyProjectile&amp;gt;()&lt;/b&gt;&lt;br&gt;ProjectileClass；MuzzlePosition；ShootRotation&lt;br&gt;Owner = 武器；Instigator = 玩家&lt;br&gt;AlwaysSpawn；生成失败直接返回&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:133&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="980" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fx" value="&lt;b&gt;生成成功 → 枪口特效 / 开火音效&lt;/b&gt;&lt;br&gt;MuzzleFlashEffect → SpawnSystemAttached&lt;br&gt;FireSound → PlaySoundAtLocation&lt;br&gt;是否播放取决于配置是否存在&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:177&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ammo" value="&lt;b&gt;消耗一发并更新弹药 HUD&lt;/b&gt;&lt;br&gt;--CurrentAmmo → UpdateAmmoHUD()&lt;br&gt;OwnerCharacter.UpadteAmmoHUD&lt;br&gt;HUDWidget.UpdateAmmo；详见 06&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:200&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#519779;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="485" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="empty" value="&lt;b&gt;打空弹匣 → StartReload()&lt;/b&gt;&lt;br&gt;只在成功生成子弹后扣弹&lt;br&gt;ReserveAmmo 不足则 StartReload 返回&lt;br&gt;连射间隔默认 0.15 秒，约 6.67 发 / 秒&lt;br&gt;&lt;font color=&quot;#65748b&quot; style=&quot;font-size:12px&quot;&gt;MyWeapon.cpp:204&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2df;strokeColor=#cf9038;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1260" y="740" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;生成后的实体子弹独立飞行&lt;/b&gt;&lt;br&gt;ProjectileMovement 负责移动&lt;br&gt;OnComponentHit 触发伤害；详见 05&lt;br&gt;相机射线本身没有调用敌人伤害函数" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#cfb85c;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#253349;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
