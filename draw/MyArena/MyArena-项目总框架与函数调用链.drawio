        <mxCell id="l1" value="A  输入与连射调度" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
