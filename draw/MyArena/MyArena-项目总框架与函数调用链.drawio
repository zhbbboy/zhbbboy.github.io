        <mxCell id="l1" value="A  移动与视角" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="40" y="170" width="540" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="B  跳跃与冲刺" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f9fafc;strokeColor=#dbe2ec;align=left;verticalAlign=top;spacingTop=15;spacingLeft=20;fontFamily=Microsoft YaHei;fontSize=19;fontStyle=1;fontColor=#52617a;connectable=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="630" y="170" width="540" height="1020" as="geometry" />
