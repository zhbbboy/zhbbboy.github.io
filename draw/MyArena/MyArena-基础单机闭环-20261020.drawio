<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="arena-oct13-1" name="01 攻击窗口与死亡反馈"><mxGraphModel page="1" pageWidth="2400" pageHeight="1850" pageScale="1" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MyArena / 01 攻击窗口与死亡反馈" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="30" width="2280" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="左：起手与结束状态；中：一次接触结算；右：致死反馈与销毁。金色Notify入口仍需动画资产实际连接。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="100" width="2280" height="40" as="geometry" /></mxCell><mxCell id="legend" value="实线：当前调用/步骤　蓝虚线：引擎事件/Timer　灰虚线：状态读取　金色虚线/框：需资产连接或条件边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="151" width="2280" height="35" as="geometry" /></mxCell><mxCell id="footer" value="核对日期：2026-10-20 · 源码根：Source/MyArenaShooter/Private · C++默认值可能被蓝图覆盖。所有节点、连线、文字均可编辑。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="1760" width="2280" height="40" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;AMyEnemyAIController::Tick&lt;/b&gt;&lt;br&gt;范围内先停移动、朝向目标&lt;br&gt;正在攻击就返回；其余起手交给Enemy&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyAIController.cpp:22&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eaf1ff;strokeColor=#5477af;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="try" value="&lt;b&gt;AMyEnemyCharacter::TryAttack(Target)&lt;/b&gt;&lt;br&gt;检查死亡/停战/攻击态/冷却与动画&lt;br&gt;默认AttackCooldown=1.5秒，由Enemy管理&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:112&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="state" value="&lt;b&gt;保存本次攻击上下文&lt;/b&gt;&lt;br&gt;弱引用AttackTarget；bIsAttacking=true&lt;br&gt;bAttackDamageApplied=false，打开一次窗口&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:112&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="play" value="&lt;b&gt;播放AttackMontage并检查返回值&lt;/b&gt;&lt;br&gt;失败 → FinishAttack还原，返回false&lt;br&gt;成功 → 设置下次起手时间并注册结束通知&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:112&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="time" value="&lt;b&gt;NextAttackTime = 当前游戏时间 + 冷却&lt;/b&gt;&lt;br&gt;不是AI逐帧维护的第二套冷却&lt;br&gt;旧StartAttack已统一转发TryAttack&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:112&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="end" value="&lt;b&gt;结束委托 + Duration+0.1秒Timer&lt;/b&gt;&lt;br&gt;正常结束/中断通知，或兜底Timer&lt;br&gt;都收敛到同一个FinishAttack&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:255&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="finish" value="&lt;b&gt;AMyEnemyCharacter::FinishAttack&lt;/b&gt;&lt;br&gt;清AttackTimer；关闭攻击与命中窗口&lt;br&gt;Reset目标，不清NextAttackTime&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:247&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="1515" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ai" target="try"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="try" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="state" target="play"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="play" target="time"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="time" target="end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="事件到达" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="end" target="finish"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="play" target="finish"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="960" /><mxPoint x="30" y="1590" /></Array></mxGeometry></mxCell><mxCell id="notify" value="&lt;b&gt;动画接触Notify【资产连接需核对】&lt;/b&gt;&lt;br&gt;接到ApplyAttackDamage入口&lt;br&gt;BlueprintCallable不会自动生成调用&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="850" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="guard" value="&lt;b&gt;AMyEnemyCharacter::ApplyAttackDamage&lt;/b&gt;&lt;br&gt;必须仍攻击、未停战、目标活动且动作播放&lt;br&gt;已消费窗口、死亡或目标无效都返回&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="consume" value="&lt;b&gt;先设bAttackDamageApplied=true&lt;/b&gt;&lt;br&gt;表示本次窗口已消费，不等于一定扣了血&lt;br&gt;后面落空也不能被第二个Notify补扣&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="range" value="&lt;b&gt;距离：SizeSquared / Square&lt;/b&gt;&lt;br&gt;目标距离必须在AttackRange + 20范围内&lt;br&gt;使用三维位置差的平方比较&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="angle" value="&lt;b&gt;朝向：DotProduct 与 Cos(半角)&lt;/b&gt;&lt;br&gt;使用水平目标方向；默认半角60度&lt;br&gt;默认阈值0.5，背向或侧向可落空&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="occlusion" value="&lt;b&gt;遮挡：LineTraceTestByChannel&lt;/b&gt;&lt;br&gt;双方PawnViewLocation之间查Visibility&lt;br&gt;忽略双方Actor；true表示有阻挡，返回&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="damage" value="&lt;b&gt;玩家 ReceiveEnemyDamage&lt;/b&gt;&lt;br&gt;全部接触条件通过才请求伤害&lt;br&gt;玩家仍要检查活动状态、有限正伤害&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:301&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="850" y="1515" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="notify" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="guard" target="consume"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="consume" target="range"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="range" target="angle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="angle" target="occlusion"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="occlusion" target="damage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b39b49;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="play" target="notify"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="960" /><mxPoint x="800" y="330" /></Array></mxGeometry></mxCell><mxCell id="accepted" value="&lt;b&gt;AMyEnemyCharacter::TakeProjectileDamage&lt;/b&gt;&lt;br&gt;致死伤害也return true：表示伤害被接受&lt;br&gt;子弹NotifyEnemyHit链恢复击杀那发标记&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:86&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="die" value="&lt;b&gt;AMyEnemyCharacter::Die&lt;/b&gt;&lt;br&gt;先bIsDead=true，再StopCombat清旧攻击&lt;br&gt;停止移动与胶囊碰撞，尝试死亡蒙太奇&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:179&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="death-result" value="&lt;b&gt;死亡播放成功 / 失败兜底&lt;/b&gt;&lt;br&gt;正返回值：注册DeathTimer后return&lt;br&gt;无资源或播放失败：直接FinishDeath&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:179&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="destroy" value="&lt;b&gt;AMyEnemyCharacter::FinishDeath&lt;/b&gt;&lt;br&gt;死亡Timer到时，或兜底直接进入&lt;br&gt;请求Destroy结束尸体Actor生命周期&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:223&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="logical" value="&lt;b&gt;Spawner按IsDead清理战斗数组&lt;/b&gt;&lt;br&gt;逻辑死亡后就可推进，不等尸体消失&lt;br&gt;死亡动画Timer与清波是独立执行阶段&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:124&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="1640" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="once" value="&lt;b&gt;AMyProjectile::OnProjectileHit&lt;/b&gt;&lt;br&gt;首次进入先标bHitProcessed&lt;br&gt;重复回调/已销毁状态拒绝再次结算&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyProjectile.cpp:72&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="1640" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="stop" value="&lt;b&gt;AMyEnemyCharacter::StopCombat&lt;/b&gt;&lt;br&gt;FinishAttack、停寻路/焦点/AI Tick&lt;br&gt;停角色移动与AttackMontage，迟到入口拒绝&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:264&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="1515" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-15" value="致死" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="accepted" target="die"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="die" target="death-result"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-17" value="到时 / 失败直接" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="death-result" target="destroy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="die" target="logical"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2370" y="540" /><mxPoint x="2370" y="1170" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="arena-oct13-2" name="02 单机回合终局与生命周期"><mxGraphModel page="1" pageWidth="2400" pageHeight="1850" pageScale="1" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MyArena / 02 单机回合终局与生命周期" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="30" width="2280" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="先写入胜负结果，再处理入口、旧工作和生命周期。多路箭头表示收尾职责，不表示多线程并行。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="100" width="2280" height="40" as="geometry" /></mxCell><mxCell id="legend" value="实线：当前调用/步骤　蓝虚线：引擎事件/Timer　灰虚线：状态读取　金色虚线/框：需资产连接或条件边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="151" width="2280" height="35" as="geometry" /></mxCell><mxCell id="footer" value="核对日期：2026-10-20 · 源码根：Source/MyArenaShooter/Private · C++默认值可能被蓝图覆盖。所有节点、连线、文字均可编辑。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="1760" width="2280" height="40" as="geometry" /></mxCell><mxCell id="win" value="&lt;b&gt;AMyArenaShooterCharacter::WinGame&lt;/b&gt;&lt;br&gt;拒绝已死/已赢；先bHasWon=true&lt;br&gt;统一收尾后再ShowVictory&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:368&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="query" value="&lt;b&gt;IsGameplayActive / CanUseWeapon&lt;/b&gt;&lt;br&gt;未死、未赢、未销毁；武器还要未停战&lt;br&gt;入口拒绝新动作只是收尾的一部分&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:433&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="850" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="die" value="&lt;b&gt;AMyArenaShooterCharacter::Die&lt;/b&gt;&lt;br&gt;活动中才进入；先bIsDead=true&lt;br&gt;统一收尾后再ShowGameOver&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:391&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="1640" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="round" value="&lt;b&gt;AMyArenaShooterCharacter::StopRoundGameplay&lt;/b&gt;&lt;br&gt;清移动意图/跳跃/冲刺/速度，禁用移动&lt;br&gt;再处理武器、World内Spawner/Enemy/Projectile&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:441&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eaf1ff;strokeColor=#5477af;" vertex="1" parent="1"><mxGeometry x="850" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="win" target="round"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="330" /><mxPoint x="800" y="540" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="die" target="round"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="330" /><mxPoint x="1590" y="540" /></Array></mxGeometry></mxCell><mxCell id="weapon" value="&lt;b&gt;AMyWeapon::StopCombat&lt;/b&gt;&lt;br&gt;永久标记停战；StopFire + CancelReload&lt;br&gt;复位姿态，清历史相机采样，禁用Actor Tick&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:446&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="cancel" value="&lt;b&gt;AMyWeapon::CancelReload&lt;/b&gt;&lt;br&gt;ClearTimer(ReloadTimerHandle)&lt;br&gt;清bIsReloading / ReloadElapsed，不转移弹药&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:439&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="callback" value="&lt;b&gt;FinishReload的防御检查&lt;/b&gt;&lt;br&gt;若额外调用：非换弹或不可用 → 取消并返回&lt;br&gt;通过检查才Min计算、转移弹药、更新HUD&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:398&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="60" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="tick" value="&lt;b&gt;Tick关闭不等于Timer自动取消&lt;/b&gt;&lt;br&gt;先清Timer，再关闭Actor Tick&lt;br&gt;新回合生成新对象，不复活旧停战武器&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:446&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="60" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="round" target="weapon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="570" /><mxPoint x="800" y="750" /></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="weapon" target="cancel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="状态复查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8e98a5;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cancel" target="callback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="spawners" value="&lt;b&gt;AMyEnemySpawner::StopSpawning&lt;/b&gt;&lt;br&gt;停止刷怪与自己的Tick&lt;br&gt;同时停止当前登记Enemy的战斗&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:161&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="bullets" value="&lt;b&gt;遍历已有AMyProjectile并Destroy&lt;/b&gt;&lt;br&gt;Actor生成后独立飞行，也必须纳入收尾&lt;br&gt;不是仅禁止下一次Fire&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:441&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="850" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="result" value="&lt;b&gt;HUD显示Victory / GameOver&lt;/b&gt;&lt;br&gt;显示在收尾之后，世界没有被SetGamePaused&lt;br&gt;必要的死亡清理Timer仍可继续运行&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:368 · MyArenaShooterCharacter.cpp:391&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="850" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="restart" value="&lt;b&gt;RestartGame → OpenLevel当前地图&lt;/b&gt;&lt;br&gt;终局后可重开；旧对象进入EndPlay&lt;br&gt;新玩家、武器、波次、HUD重新初始化&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:408&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eaf1ff;strokeColor=#5477af;" vertex="1" parent="1"><mxGeometry x="850" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="round" target="spawners"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="spawners" target="bullets"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bullets" target="result"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="enemy" value="&lt;b&gt;AMyEnemyCharacter::StopCombat&lt;/b&gt;&lt;br&gt;清攻击目标/窗口/Timer；停止蒙太奇&lt;br&gt;清AI焦点，关闭AI Tick和角色移动&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:264&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="finish" value="&lt;b&gt;AMyEnemyCharacter::FinishAttack&lt;/b&gt;&lt;br&gt;清Timer、bIsAttacking与弱目标&lt;br&gt;窗口设已消费，迟到接触入口被拒绝&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:247&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="scope" value="&lt;b&gt;TActorIterator按当前World遍历&lt;/b&gt;&lt;br&gt;终局影响匹配类的所有相关Actor&lt;br&gt;当前规则是单机实现，没有新增RPC或同步&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:441&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="1640" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="death-timer" value="&lt;b&gt;停战与死亡清理分工&lt;/b&gt;&lt;br&gt;StopCombat不清DeathTimer&lt;br&gt;Enemy.EndPlay最终清DeathTimer&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:285&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="1640" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="round" target="enemy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="570" /><mxPoint x="1590" y="750" /></Array></mxGeometry></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="enemy" target="finish"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="endplay" value="&lt;b&gt;关卡重开 / 销毁 / 结束Play → EndPlay&lt;/b&gt;&lt;br&gt;玩家：StopCombat并Destroy持有武器，RemoveFromParent移除HUD，再Super&lt;br&gt;武器：StopCombat清换弹；敌人：StopCombat并清死亡Timer，再Super&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:467 · MyEnemyCharacter.cpp:285&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="60" y="1515" width="2280" height="150" as="geometry" /></mxCell><mxCell id="edge-11" value="引擎生命周期" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="restart" target="endplay"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="arena-oct13-3" name="03 波次容错、HUD晚就绪与胜利"><mxGraphModel page="1" pageWidth="2400" pageHeight="1850" pageScale="1" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MyArena / 03 波次容错、HUD晚就绪与胜利" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="30" width="2280" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="左：SpawnWave；中：Tick推进；右：错误态与HUD缓存。0数量波、空配置、生成失败是不同情况。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="100" width="2280" height="40" as="geometry" /></mxCell><mxCell id="legend" value="实线：当前调用/步骤　蓝虚线：引擎事件/Timer　灰虚线：状态读取　金色虚线/框：需资产连接或条件边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="151" width="2280" height="35" as="geometry" /></mxCell><mxCell id="footer" value="核对日期：2026-10-20 · 源码根：Source/MyArenaShooter/Private · C++默认值可能被蓝图覆盖。所有节点、连线、文字均可编辑。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="1760" width="2280" height="40" as="geometry" /></mxCell><mxCell id="spawn" value="&lt;b&gt;AMyEnemySpawner::SpawnWave&lt;/b&gt;&lt;br&gt;已停止就返回；Waves为空报错&lt;br&gt;其余按配置依次校验与生成&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:52&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="zero" value="&lt;b&gt;while迭代跳过EnemyCount=0&lt;/b&gt;&lt;br&gt;配置非空且全部走完：返回后由Tick结算&lt;br&gt;负数量是错误，不作为空波跳过&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:52&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="validate" value="&lt;b&gt;验证类与有效出生点&lt;/b&gt;&lt;br&gt;缺失/抽象类、没有有效点 → FailSpawning&lt;br&gt;先筛ValidPoints，再用有效数组取模&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:52&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="create" value="&lt;b&gt;循环请求生成Enemy&lt;/b&gt;&lt;br&gt;有效、未销毁、未逻辑死亡才登记&lt;br&gt;部分成功Warning，按实际成功者继续&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:52&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="active" value="&lt;b&gt;bWaveActive = 数组非空&lt;/b&gt;&lt;br&gt;全生成失败 → FailSpawning&lt;br&gt;成功则更新HUD；数组只统计真实登记者&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:52&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="60" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="examples" value="&lt;b&gt;0数量波与空配置不同&lt;/b&gt;&lt;br&gt;[0,3,0]：跳首空波 → 打完3个 → 跳尾空波&lt;br&gt;[]：配置错误；[0,0]：非空配置可完成&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:52&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="60" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="spawn" target="zero"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="zero" target="validate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="validate" target="create"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="create" target="active"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tick" value="&lt;b&gt;AMyEnemySpawner::Tick&lt;/b&gt;&lt;br&gt;bSpawningStopped直接返回&lt;br&gt;普通非活动波次仍保留最终结算机会&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:17&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="850" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="player" value="&lt;b&gt;补取Player并检查活动状态&lt;/b&gt;&lt;br&gt;玩家不存在则保留后续重试机会&lt;br&gt;玩家已终局 → StopSpawning并返回&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:17&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eaf1ff;strokeColor=#5477af;" vertex="1" parent="1"><mxGeometry x="850" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="clean" value="&lt;b&gt;CleanupDeadEnemies（本波活动时）&lt;/b&gt;&lt;br&gt;倒序删除无效 / IsDead引用&lt;br&gt;循环后统一请求HUD更新&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:124&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="empty" value="&lt;b&gt;本波数组为空&lt;/b&gt;&lt;br&gt;结束本波，++CurrentWaveIndex&lt;br&gt;调用SpawnWave进入左侧配置/生成流程&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:17&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="850" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="final" value="&lt;b&gt;最终胜利检查&lt;/b&gt;&lt;br&gt;未停止、无活动波、非空配置已走完&lt;br&gt;还要求Player有效；HUD不是胜利前置条件&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:17&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="850" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="win" value="&lt;b&gt;AMyArenaShooterCharacter::WinGame&lt;/b&gt;&lt;br&gt;晚获取Player仍可结算，再StopSpawning&lt;br&gt;正常完成与错误停止不会混为一条路径&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:17 · MyArenaShooterCharacter.cpp:368&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="850" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tick" target="player"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="player" target="clean"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="clean" target="empty"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="empty" target="final"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="final" target="win"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="已走完" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="zero" target="final"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="540" /><mxPoint x="800" y="1170" /></Array></mxGeometry></mxCell><mxCell id="error" value="&lt;b&gt;AMyEnemySpawner::FailSpawning&lt;/b&gt;&lt;br&gt;bSpawnError=true；记录Error原因&lt;br&gt;StopSpawning并尝试更新HUD，不调用Win/Die&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:175&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="1640" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-11" value="配置/生成错误" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="spawn" target="error"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="230" /><mxPoint x="1990" y="230" /></Array></mxGeometry></mxCell><mxCell id="ready" value="&lt;b&gt;UpdateWaveHUD等待玩家/HUD引用&lt;/b&gt;&lt;br&gt;未就绪就返回，不提前写显示缓存&lt;br&gt;普通Tick之后可补发；错误停机不会自己重试&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:141&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="1640" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="dedupe" value="&lt;b&gt;比较接收者与显示数字&lt;/b&gt;&lt;br&gt;HUDPlayer弱引用、DisplayedWave/Enemies&lt;br&gt;新玩家或数字改变才发送&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:141&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="1640" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="send" value="&lt;b&gt;UpadteWaveHUD → UpdateWaveInfo&lt;/b&gt;&lt;br&gt;发送后更新缓存；波数用Min避免越界显示&lt;br&gt;数字补发不等于终局文字也自动补发&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:141&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="1640" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="evidence" value="&lt;b&gt;本地已有MyArena.P0报告&lt;/b&gt;&lt;br&gt;6组成功：2组普通成功 + 4组带Warning&lt;br&gt;本次整理查阅已有报告，没有重跑游戏测试&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaP0Tests.cpp:106 · MyArenaP0Tests.cpp:213&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="1640" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="manual" value="&lt;b&gt;仍需真实地图/资产核对&lt;/b&gt;&lt;br&gt;Notify时间轴、墙体Visibility、导航与手感&lt;br&gt;自动化直接调用攻击入口，不等于接好Notify&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:147&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="1640" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="player" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ready" target="dedupe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dedupe" target="send"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="summary" value="&lt;b&gt;复习入口&lt;/b&gt;&lt;br&gt;配置校验与正常推进分开；逻辑死亡计数与尸体存续分开；晚就绪与缓存更新分开。&lt;br&gt;完整函数、伪代码、API与报告范围见第9节；前面每个学习阶段仍保留在各章节。&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:17 · MyEnemySpawner.cpp:141&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="60" y="1515" width="2280" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>