<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="arena-oct13-1" name="01 敌人战斗动画与逻辑死亡"><mxGraphModel page="1" pageWidth="2400" pageHeight="1850" pageScale="1" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MyArena / 01 敌人战斗动画与逻辑死亡" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="30" width="2280" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="读法：左侧攻击时机，中间受击/死亡，右侧按逻辑死亡推进波次。Notify连接尚未从资产内部核实。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="100" width="2280" height="40" as="geometry" /></mxCell><mxCell id="legend" value="实线：当前调用/步骤　蓝虚线：Timer事件　灰虚线：状态读取　金色虚线：待连接　金色框：待接通/真实边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="151" width="2280" height="35" as="geometry" /></mxCell><mxCell id="footer" value="核对日期：2026-10-13 · 源码根：Source/MyArenaShooter/Private · C++默认值可能被蓝图覆盖。所有节点、连线、文字均可编辑。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="1760" width="2280" height="40" as="geometry" /></mxCell><mxCell id="lane-a" value="AI → 攻击动画 → 伤害请求" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="198" width="700" height="35" as="geometry" /></mxCell><mxCell id="lane-b" value="子弹 → 受击 / 死亡" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="850" y="198" width="700" height="35" as="geometry" /></mxCell><mxCell id="lane-c" value="逻辑死亡 → 波次 / 胜利" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="1640" y="198" width="700" height="35" as="geometry" /></mxCell><mxCell id="ai" value="&lt;b&gt;AMyEnemyAIController::Tick&lt;/b&gt;&lt;br&gt;敌人有效且未死亡；范围外追击&lt;br&gt;范围内停止移动，冷却归零才尝试攻击&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyAIController.cpp:22&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eaf1ff;strokeColor=#5477af;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="try" value="&lt;b&gt;AMyEnemyCharacter::TryAttack&lt;/b&gt;&lt;br&gt;检查死亡、AttackMontage与AnimInstance&lt;br&gt;攻击/受击正在播放时拒绝；成功才重置AI冷却&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:124&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="attack" value="&lt;b&gt;PlayAnimMontage(AttackMontage)&lt;/b&gt;&lt;br&gt;返回正值：开始播放成功，不代表已经伤害玩家&lt;br&gt;当前AI使用TryAttack，不使用旧StartAttack&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:124&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="notify" value="&lt;b&gt;动画接触帧 → 命名Notify【待核对】&lt;/b&gt;&lt;br&gt;示例：AnimNotify_AttackHit → Try Get Pawn Owner&lt;br&gt;Cast To MyEnemyCharacter → ApplyAttackDamage&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:156&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="damage" value="&lt;b&gt;AMyEnemyCharacter::ApplyAttackDamage&lt;/b&gt;&lt;br&gt;再检查死亡、玩家有效、当前Actor中心距离&lt;br&gt;默认150 + 20容差；满足才提出伤害请求&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:156&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="60" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="receive" value="&lt;b&gt;玩家 ReceiveEnemyDamage&lt;/b&gt;&lt;br&gt;拒绝死亡/胜利/非正伤害；否则扣血与受伤反馈&lt;br&gt;Enemy Attack Hit日志不保证玩家接受了伤害&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyArenaShooterCharacter.cpp:288&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#e6f5ed;strokeColor=#589a77;" vertex="1" parent="1"><mxGeometry x="60" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="old" value="&lt;b&gt;旧入口保留，当前主链未调用&lt;/b&gt;&lt;br&gt;StartAttack / ISAttacking / bIsAttacking&lt;br&gt;固定Timer标志与Montage播放状态是两套信息&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:46&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="60" y="1515" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ai" target="try"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="try" target="attack"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="damage" target="receive"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="动画接触帧：需核对" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b39b49;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="attack" target="notify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="需蓝图事件连接" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b39b49;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="notify" target="damage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hit" value="&lt;b&gt;AMyProjectile::OnProjectileHit&lt;/b&gt;&lt;br&gt;碰到Enemy → 请求TakeProjectileDamage&lt;br&gt;返回true才通知Hit Marker；接触特效/声音独立&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyProjectile.cpp:72&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="850" y="255" width="700" height="150" as="geometry" /></mxCell><mxCell id="enemy-damage" value="&lt;b&gt;AMyEnemyCharacter::TakeProjectileDamage&lt;/b&gt;&lt;br&gt;有效伤害先扣血，再分存活/致死&lt;br&gt;当前致死分支调用Die后return false&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:98&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="465" width="700" height="150" as="geometry" /></mxCell><mxCell id="reaction" value="&lt;b&gt;AMyEnemyCharacter::PlayHitReaction（存活）&lt;/b&gt;&lt;br&gt;攻击中跳过受击表现，但血量已经减少&lt;br&gt;之后return true → 子弹通知玩家Hit Marker&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:75&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="700" height="150" as="geometry" /></mxCell><mxCell id="die" value="&lt;b&gt;AMyEnemyCharacter::Die（逻辑死亡）&lt;/b&gt;&lt;br&gt;bIsDead=true；停AI寻路与角色移动&lt;br&gt;关闭胶囊碰撞；尝试DeathMontage&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:190&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="death-result" value="&lt;b&gt;DeathMontage播放结果&lt;/b&gt;&lt;br&gt;无资源 → 直接FinishDeath&lt;br&gt;正返回值 → 注册销毁Timer&lt;br&gt;有资源但返回0 → 当前漏掉FinishDeath兜底&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:190&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="850" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="timer" value="&lt;b&gt;DeathTimerHandle&lt;/b&gt;&lt;br&gt;用播放返回长度安排FinishDeath&lt;br&gt;这是计时回调，不是蒙太奇结束委托&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:190&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="finish" value="&lt;b&gt;AMyEnemyCharacter::FinishDeath → Destroy&lt;/b&gt;&lt;br&gt;尸体Actor之后请求销毁&lt;br&gt;战斗计数可能早已归零，胜利也可能已显示&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:233&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#ffecee;strokeColor=#b96770;" vertex="1" parent="1"><mxGeometry x="850" y="1515" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hit" target="enemy-damage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="存活" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="enemy-damage" target="reaction"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-8" value="致死" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="enemy-damage" target="die"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="540" /><mxPoint x="1590" y="960" /></Array></mxGeometry></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="die" target="death-result"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-10" value="仅播放返回正值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="death-result" target="timer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-11" value="无资源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="death-result" target="finish"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="1170" /><mxPoint x="1590" y="1590" /></Array></mxGeometry></mxCell><mxCell id="edge-12" value="到时回调" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="timer" target="finish"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="meaning" value="&lt;b&gt;本次返回值含义发生变化&lt;/b&gt;&lt;br&gt;false：拒绝伤害，或已执行致死伤害&lt;br&gt;所以击杀那发跳过Hit Marker&lt;br&gt;不能沿用上个阶段“false就是未接受”的解释&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemyCharacter.cpp:98&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="1640" y="255" width="700" height="210" as="geometry" /></mxCell><mxCell id="cleanup" value="&lt;b&gt;AMyEnemySpawner::CleanupDeadEnemies&lt;/b&gt;&lt;br&gt;无效引用，或Enemy.IsDead() → RemoveAt&lt;br&gt;不必等待死亡动画结束 / Actor销毁&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:146&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="1640" y="885" width="700" height="150" as="geometry" /></mxCell><mxCell id="empty" value="&lt;b&gt;AMyEnemySpawner::Tick：本波数组空&lt;/b&gt;&lt;br&gt;清理后更新剩余数量；结束本波并推进索引&lt;br&gt;HUD数量代表仍参与战斗的本波敌人&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:23&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="1640" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="next" value="&lt;b&gt;下一波 / AMyArenaShooterCharacter::WinGame&lt;/b&gt;&lt;br&gt;索引未到长度 → SpawnWave&lt;br&gt;全部波次完成 → 停连射、禁用移动、ShowVictory&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:23 · MyArenaShooterCharacter.cpp:355&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#f0e9fc;strokeColor=#8e70b8;" vertex="1" parent="1"><mxGeometry x="1640" y="1305" width="700" height="150" as="geometry" /></mxCell><mxCell id="independent" value="&lt;b&gt;两个结束时刻独立&lt;/b&gt;&lt;br&gt;战斗结束：IsDead使Spawner移除引用&lt;br&gt;表现结束：FinishDeath之后Actor才销毁&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyEnemySpawner.cpp:146 · MyEnemyCharacter.cpp:233&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eef2f6;strokeColor=#8595a6;" vertex="1" parent="1"><mxGeometry x="1640" y="1515" width="700" height="150" as="geometry" /></mxCell><mxCell id="edge-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="die" target="cleanup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cleanup" target="empty"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="empty" target="next"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="arena-oct13-2" name="02 武器数值驱动的表现"><mxGraphModel page="1" pageWidth="2400" pageHeight="1850" pageScale="1" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MyArena / 02 武器数值驱动的表现" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="30" width="2280" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="读法：Fire产生后坐力状态，Timer完成换弹，Tick读取并统一合成姿态。金色环节标出当前没有接通的部分。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="100" width="2280" height="40" as="geometry" /></mxCell><mxCell id="legend" value="实线：当前调用/步骤　蓝虚线：Timer事件　灰虚线：状态读取　金色虚线：待连接　金色框：待接通/真实边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="151" width="2280" height="35" as="geometry" /></mxCell><mxCell id="footer" value="核对日期：2026-10-13 · 源码根：Source/MyArenaShooter/Private · C++默认值可能被蓝图覆盖。所有节点、连线、文字均可编辑。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=0;fontColor=#243449;" parent="1" vertex="1"><mxGeometry x="60" y="1760" width="2280" height="40" as="geometry" /></mxCell><mxCell id="base" value="&lt;b&gt;AMyWeapon::BeginPlay：保存初始相对变换&lt;/b&gt;&lt;br&gt;DefaultMeshLocation / DefaultMeshRotation&lt;br&gt;每帧从固定基准叠加效果，避免累计位置漂移&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:25&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="700" height="150" as="geometry" /></mxCell><mxCell id="fire" value="&lt;b&gt;AMyWeapon::Fire成功取得可用子弹&lt;/b&gt;&lt;br&gt;相机选点与实际枪口方向不变&lt;br&gt;本次后坐力写入位于SpawnActor有效性检查之后&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:149&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="700" height="150" as="geometry" /></mxCell><mxCell id="recoil" value="&lt;b&gt;CurrentRecoilBack / Pitch累加&lt;/b&gt;&lt;br&gt;默认每发 +3距离 / +2度，分别限制上限8&lt;br&gt;最终网格后退与Pitch上抬读取这两个状态&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:247&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="60" y="655" width="700" height="150" as="geometry" /></mxCell><mxCell id="recover" value="&lt;b&gt;后坐力恢复【当前未接入】&lt;/b&gt;&lt;br&gt;RecoilRecoverySpeed已声明，但没有回零赋值&lt;br&gt;默认连续成功4发后到上限，松开不会自动归零&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:247&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="60" y="875" width="700" height="150" as="geometry" /></mxCell><mxCell id="reload" value="&lt;b&gt;AMyWeapon::StartReload&lt;/b&gt;&lt;br&gt;bIsReloading=true，ReloadElapsed=0&lt;br&gt;配置ReloadSound则播放；注册FinishReload Timer&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:336&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="850" y="435" width="700" height="150" as="geometry" /></mxCell><mxCell id="progress" value="&lt;b&gt;Tick：换弹时间 → 进度&lt;/b&gt;&lt;br&gt;ReloadElapsed += DeltaTime&lt;br&gt;Progress = Clamp(Elapsed / Max(Time,0.01), 0,1)&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:59&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="850" y="655" width="700" height="150" as="geometry" /></mxCell><mxCell id="alpha" value="&lt;b&gt;ReloadAlpha = Sin(Progress × PI)&lt;/b&gt;&lt;br&gt;0 → 1 → 0：先下沉/倾斜，再回归&lt;br&gt;Z = -15 × Alpha；Roll = 25 × Alpha（默认）&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:59&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="850" y="875" width="700" height="150" as="geometry" /></mxCell><mxCell id="reload-finish" value="&lt;b&gt;AMyWeapon::FinishReload（Timer到时）&lt;/b&gt;&lt;br&gt;补弹药；bIsReloading=false，Elapsed=0&lt;br&gt;更新弹药HUD；后续Tick令换弹姿态权重为0&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:373&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="850" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="camera" value="&lt;b&gt;Tick取得当前与上一帧相机旋转&lt;/b&gt;&lt;br&gt;FindDeltaAngleDegrees处理角度绕回&lt;br&gt;角差 / DeltaTime得到YawSpeed与PitchSpeed&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:68&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#eaf1ff;strokeColor=#5477af;" vertex="1" parent="1"><mxGeometry x="1640" y="435" width="700" height="150" as="geometry" /></mxCell><mxCell id="target" value="&lt;b&gt;目前只算TargetSwayPitch&lt;/b&gt;&lt;br&gt;-PitchSpeed × Sensitivity，再限制摆动角度&lt;br&gt;YawSpeed已计算，TargetSwayYaw未赋值&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:68&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="1640" y="655" width="700" height="150" as="geometry" /></mxCell><mxCell id="current" value="&lt;b&gt;CurrentSwayYaw / Pitch【未写回】&lt;/b&gt;&lt;br&gt;没有赋值或FInterpTo插值链，当前保持0&lt;br&gt;SwayInterpSpeed声明存在但未用于计算&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:68&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="1640" y="875" width="700" height="150" as="geometry" /></mxCell><mxCell id="future" value="&lt;b&gt;第8节单列后续补全示例&lt;/b&gt;&lt;br&gt;水平目标 + 当前摆动向目标插值&lt;br&gt;后坐力向0插值；示例尚未写入游戏代码&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:36&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff9dc;strokeColor=#b39b49;" vertex="1" parent="1"><mxGeometry x="1640" y="1095" width="700" height="150" as="geometry" /></mxCell><mxCell id="combine" value="&lt;b&gt;Tick统一合成FinalLocation / FinalRotation&lt;/b&gt;&lt;br&gt;位置 = Default + 后退偏移 + 换弹下沉&lt;br&gt;旋转 = Default + 后坐力/当前摆动 + 换弹Roll倾斜&lt;br&gt;当前先执行可能的Fire，再更新本帧网格姿态&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:36&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="600" y="1330" width="1200" height="160" as="geometry" /></mxCell><mxCell id="apply" value="&lt;b&gt;WeaponMesh → SetRelativeLocation / SetRelativeRotation&lt;/b&gt;&lt;br&gt;MuzzleLocation随父网格改变世界位置；后续Fire重新读取枪口&lt;br&gt;网格姿态不等于相机后坐力；已经生成的子弹不会被这次变换重定向&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#647389&quot;&gt;MyWeapon.cpp:145&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=15;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#243449;strokeWidth=1.8;fillColor=#fff1de;strokeColor=#bd8940;" vertex="1" parent="1"><mxGeometry x="600" y="1550" width="1200" height="130" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fire" target="recoil"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reload" target="progress"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="progress" target="alpha"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="Timer到时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#427db9;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="reload" target="reload-finish"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="510" /><mxPoint x="1590" y="1170" /></Array></mxGeometry></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="camera" target="target"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-6" value="缺少目标→当前赋值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b39b49;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="target" target="current"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-7" value="固定基准" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8e98a5;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="base" target="combine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="290" /><mxPoint x="30" y="1378" /></Array></mxGeometry></mxCell><mxCell id="edge-8" value="读取当前状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8e98a5;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="recoil" target="combine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="730" /><mxPoint x="45" y="1442" /></Array></mxGeometry></mxCell><mxCell id="edge-9" value="读取权重" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8e98a5;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.45;entryY=0;" edge="1" parent="1" source="alpha" target="combine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="950" /><mxPoint x="790" y="1285" /><mxPoint x="1140" y="1285" /></Array></mxGeometry></mxCell><mxCell id="edge-10" value="读取当前值（目前为0）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8e98a5;dashed=1;dashPattern=6 4;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="current" target="combine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2365" y="950" /><mxPoint x="2365" y="1410" /></Array></mxGeometry></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f627b;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="combine" target="apply"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>